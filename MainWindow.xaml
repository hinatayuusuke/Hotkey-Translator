<Window x:Class="Hotkey_Translator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotkey_Translator"
        mc:Ignorable="d"
        Title="Hotkey Translator" Height="640" Width="1080">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="580" MinWidth="380" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <TabControl Grid.Column="0" Margin="0,0,12,0">
            <TabItem Header="Main">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="Capture" FontWeight="SemiBold" />
                        <Grid Margin="0,6,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CaptureModeBox" Width="200" HorizontalAlignment="Left" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="Screen" Tag="Screen" />
                                <ComboBoxItem Content="Active Window" Tag="ActiveWindow" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Provider" VerticalAlignment="Center" Margin="0,6,0,0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                                <ComboBox x:Name="CaptureProviderBox" Width="200" HorizontalAlignment="Left" SelectionChanged="OnSettingChanged">
                                    <ComboBoxItem Content="WGC" Tag="Wgc" />
                                    <ComboBoxItem Content="DXGI" Tag="Dxgi" />
                                    <ComboBoxItem Content="GDI" Tag="Gdi" />
                                </ComboBox>
                                <CheckBox x:Name="CaptureProviderFixedCheck" Content="Fixed only" VerticalAlignment="Center" Margin="10,0,0,0" Click="OnSettingChanged" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="ROI" VerticalAlignment="Center" Margin="0,6,0,0" />

                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="SelectRoiButton" Content="Select ROI" Width="140" HorizontalAlignment="Left" Click="OnSelectRoi" />
    
                                <CheckBox x:Name="EnableRoiCheck" Content="Enable" VerticalAlignment="Center" Margin="10,0,0,0" Click="OnSettingChanged" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RoiStatusText" Text="ROI: not set" Margin="0,6,0,0" Grid.ColumnSpan="2" />
                        </Grid>

                        <Separator Margin="0,10,0,10" />

                        <TextBlock Text="OCR" FontWeight="SemiBold" />
                        <Grid Margin="0,6,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Engine" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="OcrEngineBox" Width="200" HorizontalAlignment="Left" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="WinRT (Windows)" Tag="WinRt" />
                                <ComboBoxItem Content="PaddleOCR (uv)" Tag="Paddle" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Text="Resources are released on the next launch. Turn OFF and restart the app to free memory."
                                   Foreground="DimGray"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <Separator Margin="0,10,0,10" />
                        <TextBlock Text="Translation" FontWeight="SemiBold" />

                        <Grid Margin="0,6,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Source" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Target" VerticalAlignment="Center" Margin="0,6,0,0" />

                            <!-- 右側（Source/Target + Swap）をひとつのGridにまとめる -->
                            <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />  <!-- Combo -->
                                    <ColumnDefinition Width="32" />   <!-- Swap -->
                                    <ColumnDefinition Width="Auto" /> <!-- Custom -->
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Source -->
                                <ComboBox Grid.Row="0" Grid.Column="0"
                                        x:Name="SourceLangCombo"
                                        Width="160"
                                        SelectionChanged="OnLanguageSelectionChanged">
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="日本語" Tag="ja" />
                                    <ComboBoxItem Content="中文(繁體)" Tag="zh-Hant" />
                                    <ComboBoxItem Content="中文(简体)" Tag="zh-Hans" />
                                    <ComboBoxItem Content="Русский" Tag="ru" />
                                    <ComboBoxItem Content="Custom..." Tag="custom" />
                                </ComboBox>

                                <TextBox Grid.Row="0" Grid.Column="2"
                                        x:Name="SourceLangCustom"
                                        Width="90"
                                        Margin="8,0,0,0"
                                        LostFocus="OnSettingLostFocus"
                                        Visibility="Collapsed" />

                                <!-- Target -->
                                <ComboBox Grid.Row="1" Grid.Column="0"
                                        x:Name="TargetLangCombo"
                                        Width="160"
                                        Margin="0,6,0,0"
                                        SelectionChanged="OnLanguageSelectionChanged">
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="日本語" Tag="ja" />
                                    <ComboBoxItem Content="中文(繁體)" Tag="zh-Hant" />
                                    <ComboBoxItem Content="中文(简体)" Tag="zh-Hans" />
                                    <ComboBoxItem Content="Русский" Tag="ru" />
                                    <ComboBoxItem Content="Custom..." Tag="custom" />
                                </ComboBox>

                                <TextBox Grid.Row="1" Grid.Column="2"
                                        x:Name="TargetLangCustom"
                                        Width="90"
                                        Margin="8,6,0,0"
                                        LostFocus="OnSettingLostFocus"
                                        Visibility="Collapsed" />

                                <!-- Swap（常にComboのすぐ右に固定） -->
                                <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                        x:Name="SwapLangButton"
                                        Width="28" Height="28"
                                        Margin="4,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Click="OnSwapLanguages"
                                        ToolTip="Swap languages">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                                            Text="&#xE117;"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                </Button>
                            </Grid>

                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox x:Name="EnableDeepLCheck" Content="Enable DeepL" Click="OnSettingChanged" />
                                <CheckBox x:Name="EnableGeminiCheck" Content="Enable Gemini" Margin="12,0,0,0" Click="OnSettingChanged" />
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,10,0,10" />
                        <TextBlock Text="Overlay" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Overlay base font" Width="150" VerticalAlignment="Center" />
                            <Slider x:Name="OverlayFontSizeSlider"
                                    Width="180"
                                    Minimum="8"
                                    Maximum="96"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    SmallChange="1"
                                    LargeChange="2"
                                    ValueChanged="OnOverlayFontSizeChanged" />
                            <TextBlock x:Name="OverlayFontSizeValue"
                                       Width="48"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Overlay opacity" Width="150" VerticalAlignment="Center" />
                            <Slider x:Name="OverlayBackgroundOpacitySlider"
                                    Width="180"
                                    Minimum="0"
                                    Maximum="1"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="0.05"
                                    SmallChange="0.01"
                                    LargeChange="0.1"
                                    ValueChanged="OnOverlayBackgroundOpacityChanged" />
                            <TextBlock x:Name="OverlayBackgroundOpacityValue"
                                       Width="48"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right" />
                        </StackPanel>

                        <Separator Margin="0,10,0,10" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#33000000" BorderThickness="0,0,1,0" Padding="0,0,8,0">
                                <ListBox x:Name="SettingsCategoryList" SelectionChanged="OnSettingsCategoryChanged" SelectedIndex="0">
                                    <ListBoxItem Content="OCR" />
                                    <ListBoxItem Content="Paddle OCR" />
                                    <ListBoxItem Content="Translation" />
                                    <ListBoxItem Content="Hotkeys" />
                                </ListBox>
                            </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <StackPanel x:Name="SettingsPanelOcr">
                                <TextBlock Text="OCR (Advanced)" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="pHash threshold" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="PhashThresholdBox" Width="80" LostFocus="OnSettingLostFocus" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="IoU threshold" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="IouThresholdBox" Width="80" LostFocus="OnSettingLostFocus" />
                                </StackPanel>

                                <Separator Margin="0,10,0,8" />
                                <TextBlock Text="Performance" FontWeight="SemiBold" />
                                <CheckBox x:Name="EnableLoggingCheck" Content="Enable logging" Margin="0,6,0,0" Click="OnSettingChanged" />
                                <CheckBox x:Name="EnableOcrPerfLogCheck" Content="Enable OCR perf log" Margin="0,6,0,0" Click="OnSettingChanged" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Log threshold (ms)" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="OcrPerfLogThresholdBox" Width="80" LostFocus="OnSettingLostFocus" />
                                </StackPanel>

                                <Separator Margin="0,10,0,8" />
                                <TextBlock Text="OCR Preprocess (Binarization)" FontWeight="SemiBold" />
                                <CheckBox x:Name="EnableOcrBinarizationCheck" Content="Enable binarization" Margin="0,6,0,0" Click="OnSettingChanged" />
                                <CheckBox x:Name="EnableOcrAutoThresholdCheck" Content="Auto threshold (Otsu)" Margin="0,4,0,0" Click="OnSettingChanged" />
                                <CheckBox x:Name="EnableOcrAutoInvertCheck" Content="Auto invert (dark background)" Margin="0,4,0,0" Click="OnSettingChanged" />
                                <CheckBox x:Name="EnableOcrGammaCheck" Content="Enable gamma correction" Margin="0,4,0,0" Click="OnSettingChanged" />
                                <CheckBox x:Name="EnableOcrTwoPassCheck" Content="Two-pass OCR (low/high)" Margin="0,6,0,0" Click="OnSettingChanged" />
                                <CheckBox x:Name="OcrTwoPassPreferAutoCheck" Content="Prefer auto threshold when enabled" Margin="0,4,0,0" Click="OnSettingChanged" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Low threshold" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="OcrTwoPassLowThresholdSlider"
                                            Width="180"
                                            Minimum="0"
                                            Maximum="255"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="5"
                                            SmallChange="1"
                                            LargeChange="10"
                                            ValueChanged="OnOcrTwoPassLowThresholdChanged" />
                                    <TextBlock x:Name="OcrTwoPassLowThresholdValue" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="High threshold" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="OcrTwoPassHighThresholdSlider"
                                            Width="180"
                                            Minimum="0"
                                            Maximum="255"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="5"
                                            SmallChange="1"
                                            LargeChange="10"
                                            ValueChanged="OnOcrTwoPassHighThresholdChanged" />
                                    <TextBlock x:Name="OcrTwoPassHighThresholdValue" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Threshold" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="OcrBinarizationThresholdSlider"
                                            Width="180"
                                            Minimum="0"
                                            Maximum="255"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="5"
                                            SmallChange="1"
                                            LargeChange="10"
                                            ValueChanged="OnOcrBinarizationThresholdChanged" />
                                    <TextBlock x:Name="OcrBinarizationThresholdValue" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Gamma" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="OcrGammaSlider"
                                            Width="180"
                                            Minimum="0.6"
                                            Maximum="1.8"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="0.1"
                                            SmallChange="0.05"
                                            LargeChange="0.1"
                                            ValueChanged="OnOcrGammaChanged" />
                                    <TextBlock x:Name="OcrGammaValue" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" />
                                </StackPanel>

                                <Separator Margin="0,12,0,8" />
                                <TextBlock Text="OCR Input" FontWeight="SemiBold" />
                                <CheckBox x:Name="EnableOcrDownsamplingCheck"
                                          Content="Downsample OCR input"
                                          Margin="0,6,0,0"
                                          Click="OnSettingChanged" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Downsample scale" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="OcrDownsampleScaleSlider"
                                            Width="180"
                                            Minimum="0.5"
                                            Maximum="1.0"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="0.05"
                                            SmallChange="0.05"
                                            LargeChange="0.1"
                                            ValueChanged="OnOcrDownsampleScaleChanged" />
                                    <TextBlock x:Name="OcrDownsampleScaleValue"
                                               Width="48"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right" />
                                </StackPanel>
                                <TextBlock Text="OCR input preview" Margin="0,10,0,4" />
                                <Border BorderBrush="#33000000" BorderThickness="1" Background="#0A000000" Width="640" Height="360">
                                    <Grid>
                                        <Image x:Name="OcrPreprocessPreviewImage" Stretch="Uniform" />
                                        <TextBlock x:Name="OcrPreprocessPreviewHint"
                                                   Text="Run OCR to update preview."
                                                   Foreground="DimGray"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>

                                <Separator Margin="0,12,0,8" />
                                <TextBlock Text="Overlay Layout" FontWeight="SemiBold" />
                                <CheckBox x:Name="EnableFixedRoiOverlayCheck" Content="Fixed ROI overlay mode" Margin="0,6,0,0" Click="OnSettingChanged" />
                                <CheckBox x:Name="EnableOverlayShortLineShrinkCheck" Content="Shrink overlay for 1–2 lines" Margin="0,4,0,0" Click="OnSettingChanged" />

                                <Separator Margin="0,12,0,8" />
                                <TextBlock Text="Scene Change Auto-hide" FontWeight="SemiBold" />
                                <CheckBox x:Name="EnableSceneChangeAutoHideCheck" Content="Enable auto-hide on scene change" Margin="0,6,0,0" Click="OnSettingChanged" />
                                <CheckBox x:Name="EnableSceneChangeTextWeightedCheck" Content="Use text-weighted scoring" Margin="0,4,0,0" Click="OnSettingChanged" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Scene change threshold" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="SceneChangeThresholdSlider"
                                            Width="180"
                                            Minimum="0"
                                            Maximum="1"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="0.05"
                                            SmallChange="0.01"
                                            LargeChange="0.1"
                                            ValueChanged="OnSceneChangeThresholdChanged" />
                                    <TextBlock x:Name="SceneChangeThresholdValue" Width="48" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Watch interval (ms)" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="SceneChangeWatchIntervalSlider"
                                            Width="180"
                                            Minimum="200"
                                            Maximum="5000"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="200"
                                            SmallChange="100"
                                            LargeChange="500"
                                            ValueChanged="OnSceneChangeWatchIntervalChanged" />
                                    <TextBlock x:Name="SceneChangeWatchIntervalValue" Width="60" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Watcher pHash threshold" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="SceneChangeWatchPhashSlider"
                                            Width="180"
                                            Minimum="0"
                                            Maximum="64"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="2"
                                            SmallChange="1"
                                            LargeChange="5"
                                            ValueChanged="OnSceneChangeWatchPhashChanged" />
                                    <TextBlock x:Name="SceneChangeWatchPhashValue" Width="48" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="SettingsPanelPaddle" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock Text="Paddle OCR" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Detection model" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="PaddleDetectionModelBox" Width="220" SelectionChanged="OnSettingChanged">
                                        <ComboBoxItem Content="Mobile (PP-OCRv5_mobile_det)" Tag="PP-OCRv5_mobile_det" />
                                        <ComboBoxItem Content="Server (PP-OCRv5_server_det)" Tag="PP-OCRv5_server_det" />
                                    </ComboBox>
                                </StackPanel>
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="Recognition model" Width="120" VerticalAlignment="Center" />
                                      <ComboBox x:Name="PaddleRecognitionModelBox" Width="220" SelectionChanged="OnSettingChanged">
                                          <ComboBoxItem Content="Auto (source language)" Tag="auto" />
                                          <ComboBoxItem Content="Server (PP-OCRv5_server_rec)" Tag="PP-OCRv5_server_rec" />
                                        <ComboBoxItem Content="English (en_PP-OCRv5_mobile_rec)" Tag="en_PP-OCRv5_mobile_rec" />
                                        <ComboBoxItem Content="Latin (latin_PP-OCRv5_mobile_rec)" Tag="latin_PP-OCRv5_mobile_rec" />
                                        <ComboBoxItem Content="East Slavic (eslav_PP-OCRv5_mobile_rec)" Tag="eslav_PP-OCRv5_mobile_rec" />
                                        <ComboBoxItem Content="Korean (korean_PP-OCRv5_mobile_rec)" Tag="korean_PP-OCRv5_mobile_rec" />
                                        <ComboBoxItem Content="Thai (th_PP-OCRv5_mobile_rec)" Tag="th_PP-OCRv5_mobile_rec" />
                                        <ComboBoxItem Content="Greek (el_PP-OCRv5_mobile_rec)" Tag="el_PP-OCRv5_mobile_rec" />
                                        <ComboBoxItem Content="Arabic (arabic_PP-OCRv5_mobile_rec)" Tag="arabic_PP-OCRv5_mobile_rec" />
                                        <ComboBoxItem Content="Cyrillic (cyrillic_PP-OCRv5_mobile_rec)" Tag="cyrillic_PP-OCRv5_mobile_rec" />
                                        <ComboBoxItem Content="Devanagari (devanagari_PP-OCRv5_mobile_rec)" Tag="devanagari_PP-OCRv5_mobile_rec" />
                                          <ComboBoxItem Content="Telugu (te_PP-OCRv5_mobile_rec)" Tag="te_PP-OCRv5_mobile_rec" />
                                          <ComboBoxItem Content="Tamil (ta_PP-OCRv5_mobile_rec)" Tag="ta_PP-OCRv5_mobile_rec" />
                                      </ComboBox>
                                  </StackPanel>
                                  <CheckBox x:Name="EnablePaddleConfidenceFilterCheck"
                                            Content="Filter low-confidence lines (Paddle only)"
                                            Margin="0,8,0,0"
                                            Click="OnSettingChanged" />
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="Confidence threshold" Width="120" VerticalAlignment="Center" />
                                      <Slider x:Name="PaddleConfidenceThresholdSlider"
                                              Width="180"
                                              Minimum="0"
                                              Maximum="1"
                                              IsSnapToTickEnabled="True"
                                              TickFrequency="0.05"
                                              SmallChange="0.01"
                                              LargeChange="0.1"
                                              ValueChanged="OnPaddleConfidenceThresholdChanged" />
                                      <TextBlock x:Name="PaddleConfidenceThresholdValue"
                                                 Width="36"
                                                 Margin="8,0,0,0"
                                                 VerticalAlignment="Center"
                                                 TextAlignment="Right" />
                                  </StackPanel>
                                  <TextBlock Text="Language follows Main settings." Foreground="DimGray" Margin="0,6,0,0" />
                              </StackPanel>

                              <StackPanel x:Name="SettingsPanelTranslation" Visibility="Collapsed" Margin="0,12,0,0">
                                  <TextBlock Text="Translation (Advanced)" FontWeight="SemiBold" />
                                  <TextBlock x:Name="TranslationStatusText" Text="Translation status: unknown" Foreground="DimGray" Margin="0,6,0,6" />
                                  <Separator Margin="0,8,0,8" />
                                  <StackPanel Visibility="Collapsed">
                                      <TextBlock Text="Local NLLB200 (CTranslate2)" FontWeight="SemiBold" />
                                      <CheckBox x:Name="EnableCTranslate2Check"
                                                Content="Enable CTranslate2 translation"
                                                Margin="0,6,0,0"
                                                Click="OnSettingChanged" />
                                      <TextBlock Text="Resources are released on the next launch. Turn OFF and restart the app to free memory."
                                                 Foreground="DimGray"
                                                 TextWrapping="Wrap"
                                                 Margin="0,4,0,0" />
                                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                          <TextBlock Text="Device" Width="120" VerticalAlignment="Center" />
                                          <ComboBox x:Name="CTranslate2DeviceBox" Width="120" SelectionChanged="OnSettingChanged">
                                              <ComboBoxItem Content="CPU" Tag="cpu" />
                                              <ComboBoxItem Content="GPU" Tag="gpu" />
                                          </ComboBox>
                                      </StackPanel>
                                  </StackPanel>
                                  <Separator Margin="0,10,0,8" />
                                  <TextBlock Text="Local Llama.cpp (GGUF)" FontWeight="SemiBold" />
                                  <CheckBox x:Name="EnableLlamaCppCheck"
                                            Content="Enable Llama.cpp translation"
                                            Margin="0,6,0,0"
                                            Click="OnSettingChanged" />
                                  <TextBlock Text="Resources are released on the next launch. Turn OFF and restart the app to free memory."
                                             Foreground="DimGray"
                                             TextWrapping="Wrap"
                                             Margin="0,4,0,0" />
                                  <TextBlock Text="Model files are loaded from TranslationServiceLlama\LlamaCpp\Models"
                                             Foreground="DimGray"
                                             Margin="0,6,0,0" />
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="Model" Width="120" VerticalAlignment="Center" />
                                      <ComboBox x:Name="LlamaModelBox" Width="320" SelectionChanged="OnSettingChanged" />
                                      <Button Content="Reload" Width="70" Margin="8,0,0,0" Click="OnReloadLlamaModels" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="Runtime control" Width="120" VerticalAlignment="Center" />
                                      <Button Content="Restart Llama.cpp" Width="150" Click="OnRestartLlamaCpp" />
                                      <Button Content="Stop llama-server" Width="130" Margin="8,0,0,0" Click="OnStopLlamaServer" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="HTTP host" Width="120" VerticalAlignment="Center" />
                                      <TextBox x:Name="LlamaHostBox" Width="120" LostFocus="OnSettingLostFocus" />
                                      <TextBlock Text="Port" Width="40" Margin="8,0,0,0" VerticalAlignment="Center" />
                                      <TextBox x:Name="LlamaPortBox" Width="80" LostFocus="OnSettingLostFocus" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="Context size" Width="120" VerticalAlignment="Center" />
                                      <TextBox x:Name="LlamaContextSizeBox" Width="80" LostFocus="OnSettingLostFocus" />
                                      <TextBlock Text="GPU layers" Width="80" Margin="8,0,0,0" VerticalAlignment="Center" />
                                      <TextBox x:Name="LlamaGpuLayersBox" Width="80" LostFocus="OnSettingLostFocus" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="Threads" Width="120" VerticalAlignment="Center" />
                                      <TextBox x:Name="LlamaThreadsBox" Width="80" LostFocus="OnSettingLostFocus" />
                                      <TextBlock Text="Parallel" Width="80" Margin="8,0,0,0" VerticalAlignment="Center" />
                                      <TextBox x:Name="LlamaParallelBox" Width="80" LostFocus="OnSettingLostFocus" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="Batch size" Width="120" VerticalAlignment="Center" />
                                      <TextBox x:Name="LlamaBatchSizeBox" Width="80" LostFocus="OnSettingLostFocus" />
                                      <TextBlock Text="Max tokens" Width="80" Margin="8,0,0,0" VerticalAlignment="Center" />
                                      <TextBox x:Name="LlamaMaxTokensBox" Width="80" LostFocus="OnSettingLostFocus" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="Temperature" Width="120" VerticalAlignment="Center" />
                                      <TextBox x:Name="LlamaTemperatureBox" Width="80" LostFocus="OnSettingLostFocus" />
                                      <TextBlock Text="Top P" Width="80" Margin="8,0,0,0" VerticalAlignment="Center" />
                                      <TextBox x:Name="LlamaTopPBox" Width="80" LostFocus="OnSettingLostFocus" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="Top K" Width="120" VerticalAlignment="Center" />
                                      <TextBox x:Name="LlamaTopKBox" Width="80" LostFocus="OnSettingLostFocus" />
                                      <TextBlock Text="Repeat penalty" Width="80" Margin="8,0,0,0" VerticalAlignment="Center" />
                                      <TextBox x:Name="LlamaRepeatPenaltyBox" Width="80" LostFocus="OnSettingLostFocus" />
                                  </StackPanel>
                                  <Separator Margin="0,10,0,8" />
                                  <StackPanel Orientation="Horizontal">
                                      <TextBlock Text="DeepL API key" Width="120" VerticalAlignment="Center" />
                                      <PasswordBox x:Name="DeepLApiKeyBox" Width="200" LostFocus="OnSettingLostFocus" />
                                  </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="DeepL endpoint" Width="120" VerticalAlignment="Center" />
                                    <TextBox x:Name="DeepLEndpointBox" Width="200" LostFocus="OnSettingLostFocus" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Gemini API key" Width="120" VerticalAlignment="Center" />
                                    <PasswordBox x:Name="ApiKeyBox" Width="200" LostFocus="OnSettingLostFocus" />
                                </StackPanel>
                                <TextBlock Text="Translation priority" Margin="0,10,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <ListBox x:Name="TranslationPriorityList" Width="180" Height="80" />
                                    <StackPanel Margin="6,0,0,0">
                                        <Button Content="Up" Width="60" Click="OnTranslationPriorityUp" />
                                        <Button Content="Down" Width="60" Margin="0,6,0,0" Click="OnTranslationPriorityDown" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="SettingsPanelHotkeys" Visibility="Collapsed" Margin="0,12,0,0">
                                <TextBlock Text="Hotkeys" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Run once" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HotkeyRunOnceKeyBox" Width="80" SelectionChanged="OnHotkeySelectionChanged" />
                                    <CheckBox x:Name="HotkeyRunOnceCtrl" Content="Ctrl" Margin="8,0,0,0" Click="OnSettingChanged" />
                                    <CheckBox x:Name="HotkeyRunOnceAlt" Content="Alt" Margin="6,0,0,0" Click="OnSettingChanged" />
                                    <CheckBox x:Name="HotkeyRunOnceShift" Content="Shift" Margin="6,0,0,0" Click="OnSettingChanged" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Toggle overlay" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HotkeyToggleOverlayKeyBox" Width="80" SelectionChanged="OnHotkeySelectionChanged" />
                                    <CheckBox x:Name="HotkeyToggleOverlayCtrl" Content="Ctrl" Margin="8,0,0,0" Click="OnSettingChanged" />
                                    <CheckBox x:Name="HotkeyToggleOverlayAlt" Content="Alt" Margin="6,0,0,0" Click="OnSettingChanged" />
                                    <CheckBox x:Name="HotkeyToggleOverlayShift" Content="Shift" Margin="6,0,0,0" Click="OnSettingChanged" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Force run" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HotkeyForceRunKeyBox" Width="80" SelectionChanged="OnHotkeySelectionChanged" />
                                    <CheckBox x:Name="HotkeyForceRunCtrl" Content="Ctrl" Margin="8,0,0,0" Click="OnSettingChanged" />
                                    <CheckBox x:Name="HotkeyForceRunAlt" Content="Alt" Margin="6,0,0,0" Click="OnSettingChanged" />
                                    <CheckBox x:Name="HotkeyForceRunShift" Content="Shift" Margin="6,0,0,0" Click="OnSettingChanged" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Force Gemini (strict)" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HotkeyForceGeminiStrictKeyBox" Width="80" SelectionChanged="OnHotkeySelectionChanged" />
                                    <CheckBox x:Name="HotkeyForceGeminiStrictCtrl" Content="Ctrl" Margin="8,0,0,0" Click="OnSettingChanged" />
                                    <CheckBox x:Name="HotkeyForceGeminiStrictAlt" Content="Alt" Margin="6,0,0,0" Click="OnSettingChanged" />
                                    <CheckBox x:Name="HotkeyForceGeminiStrictShift" Content="Shift" Margin="6,0,0,0" Click="OnSettingChanged" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Overlay text" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HotkeyOcrOnlyKeyBox" Width="80" SelectionChanged="OnHotkeySelectionChanged" />
                                    <CheckBox x:Name="HotkeyOcrOnlyCtrl" Content="Ctrl" Margin="8,0,0,0" Click="OnSettingChanged" />
                                    <CheckBox x:Name="HotkeyOcrOnlyAlt" Content="Alt" Margin="6,0,0,0" Click="OnSettingChanged" />
                                    <CheckBox x:Name="HotkeyOcrOnlyShift" Content="Shift" Margin="6,0,0,0" Click="OnSettingChanged" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Select ROI" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HotkeySelectRoiKeyBox" Width="80" SelectionChanged="OnHotkeySelectionChanged" />
                                    <CheckBox x:Name="HotkeySelectRoiCtrl" Content="Ctrl" Margin="8,0,0,0" Click="OnSettingChanged" />
                                    <CheckBox x:Name="HotkeySelectRoiAlt" Content="Alt" Margin="6,0,0,0" Click="OnSettingChanged" />
                                    <CheckBox x:Name="HotkeySelectRoiShift" Content="Shift" Margin="6,0,0,0" Click="OnSettingChanged" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Lock window" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HotkeyLockCaptureWindowKeyBox" Width="80" SelectionChanged="OnHotkeySelectionChanged" />
                                    <CheckBox x:Name="HotkeyLockCaptureWindowCtrl" Content="Ctrl" Margin="8,0,0,0" Click="OnSettingChanged" />
                                    <CheckBox x:Name="HotkeyLockCaptureWindowAlt" Content="Alt" Margin="6,0,0,0" Click="OnSettingChanged" />
                                    <CheckBox x:Name="HotkeyLockCaptureWindowShift" Content="Shift" Margin="6,0,0,0" Click="OnSettingChanged" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Unlock window" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HotkeyUnlockCaptureWindowKeyBox" Width="80" SelectionChanged="OnHotkeySelectionChanged" />
                                    <CheckBox x:Name="HotkeyUnlockCaptureWindowCtrl" Content="Ctrl" Margin="8,0,0,0" Click="OnSettingChanged" />
                                    <CheckBox x:Name="HotkeyUnlockCaptureWindowAlt" Content="Alt" Margin="6,0,0,0" Click="OnSettingChanged" />
                                    <CheckBox x:Name="HotkeyUnlockCaptureWindowShift" Content="Shift" Margin="6,0,0,0" Click="OnSettingChanged" />
                                </StackPanel>
                                <TextBlock Text="Note: Win key is not supported." Foreground="DimGray" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

        <TextBox x:Name="LogBox" Grid.Column="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

        <Grid x:Name="BusyOverlay" Grid.ColumnSpan="3" Background="Transparent" Visibility="Collapsed" Panel.ZIndex="10">
            <Border Background="#F8FFFFFF" Padding="24" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="BusyOverlayText" Text="OCR running..." FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ProgressBar Width="220" Height="6" IsIndeterminate="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
