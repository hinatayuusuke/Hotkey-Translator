<Window x:Class="Hotkey_Translator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotkey_Translator"
        mc:Ignorable="d"
        Title="Hotkey Translator" Height="640" Width="920">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Expander Header="Capture" IsExpanded="True">
                    <StackPanel Margin="0,6,0,0">
                        <ComboBox x:Name="CaptureModeBox">
                            <ComboBoxItem Content="Screen" Tag="Screen" />
                            <ComboBoxItem Content="Active Window" Tag="ActiveWindow" />
                        </ComboBox>
                        <Button x:Name="SelectRoiButton" Content="Select ROI" Margin="0,6,0,0" Click="OnSelectRoi" />
                        <CheckBox x:Name="EnableRoiCheck" Content="Enable ROI" Margin="0,6,0,0" />
                        <TextBlock x:Name="RoiStatusText" Text="ROI: not set" Margin="0,4,0,0" />
                    </StackPanel>
                </Expander>

                <Expander Header="OCR" IsExpanded="True" Margin="0,10,0,0">
                    <StackPanel Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="OCR engine" Width="150" VerticalAlignment="Center" />
                            <ComboBox x:Name="OcrEngineBox" Width="160">
                                <ComboBoxItem Content="WinRT (Windows)" Tag="WinRt" />
                                <ComboBoxItem Content="PaddleOCR (uv)" Tag="Paddle" />
                            </ComboBox>
                        </StackPanel>

                        <Expander Header="Paddle settings" IsExpanded="False" Margin="0,6,0,0">
                            <StackPanel Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Project" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="PaddleProjectDirBox" Width="180" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Language" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="PaddleLanguageBox" Width="80" />
                                    <TextBlock Text="Device" Width="50" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="PaddleDeviceBox" Width="60" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="uv path" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="PaddleUvPathBox" Width="180" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Model dir" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="PaddleModelDirBox" Width="180" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Advanced" IsExpanded="False" Margin="0,6,0,0">
                            <StackPanel Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="pHash threshold" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="PhashThresholdBox" Width="80" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="IoU threshold" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="IouThresholdBox" Width="80" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Expander>

                <Expander Header="Translation" IsExpanded="True" Margin="0,10,0,0">
                    <StackPanel Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Source" Width="60" VerticalAlignment="Center" />
                            <TextBox x:Name="SourceLangBox" Width="80" />
                            <TextBlock Text="Target" Width="60" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBox x:Name="TargetLangBox" Width="80" />
                        </StackPanel>

                        <CheckBox x:Name="EnableDeepLCheck" Content="Enable DeepL" Margin="0,6,0,0" />
                        <CheckBox x:Name="EnableGeminiCheck" Content="Enable Gemini" Margin="0,6,0,0" />
                        <TextBlock x:Name="TranslationStatusText" Text="Translation status: unknown" Foreground="DimGray" Margin="0,4,0,0" />

                        <Expander Header="Advanced" IsExpanded="False" Margin="0,6,0,0">
                            <StackPanel Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="DeepL API key" Width="120" VerticalAlignment="Center" />
                                    <PasswordBox x:Name="DeepLApiKeyBox" Width="200" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="DeepL endpoint" Width="120" VerticalAlignment="Center" />
                                    <TextBox x:Name="DeepLEndpointBox" Width="200" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Gemini API key" Width="120" VerticalAlignment="Center" />
                                    <PasswordBox x:Name="ApiKeyBox" Width="200" />
                                </StackPanel>
                                <TextBlock Text="Translation priority" Margin="0,10,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <ListBox x:Name="TranslationPriorityList" Width="180" Height="80" />
                                    <StackPanel Margin="6,0,0,0">
                                        <Button Content="Up" Width="60" Click="OnTranslationPriorityUp" />
                                        <Button Content="Down" Width="60" Margin="0,6,0,0" Click="OnTranslationPriorityDown" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Expander>

                <Separator Margin="0,10,0,10" />

                <Button x:Name="SaveSettingsButton" Content="Save Settings" Click="OnSaveSettings" />
                <Button x:Name="RunOnceButton" Content="Run Once (F8)" Margin="0,6,0,0" Click="OnRunOnce" />
            </StackPanel>
        </ScrollViewer>

        <TextBox x:Name="LogBox" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
    </Grid>
</Window>
