<Window x:Class="Hotkey_Translator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotkey_Translator"
        mc:Ignorable="d"
        Title="Hotkey Translator" Height="640" Width="1080">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="580" MinWidth="380" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <TabControl Grid.Column="0" Margin="0,0,12,0">
            <TabItem Header="Main">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="Capture" FontWeight="SemiBold" />
                        <Grid Margin="0,6,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CaptureModeBox" Width="200" HorizontalAlignment="Left" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="Screen" Tag="Screen" />
                                <ComboBoxItem Content="Active Window" Tag="ActiveWindow" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ROI" VerticalAlignment="Center" Margin="0,6,0,0" />

                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="SelectRoiButton" Content="Select ROI" Width="140" HorizontalAlignment="Left" Click="OnSelectRoi" />
    
                                <CheckBox x:Name="EnableRoiCheck" Content="Enable" VerticalAlignment="Center" Margin="10,0,0,0" Click="OnSettingChanged" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RoiStatusText" Text="ROI: not set" Margin="0,6,0,0" Grid.ColumnSpan="2" />
                        </Grid>

                        <Separator Margin="0,10,0,10" />

                        <TextBlock Text="OCR" FontWeight="SemiBold" />
                        <Grid Margin="0,6,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Engine" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="OcrEngineBox" Width="200" HorizontalAlignment="Left" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="WinRT (Windows)" Tag="WinRt" />
                                <ComboBoxItem Content="PaddleOCR (uv)" Tag="Paddle" />
                            </ComboBox>
                        </Grid>

                        <Separator Margin="0,10,0,10" />

                        <TextBlock Text="Translation" FontWeight="SemiBold" />
                        <Grid Margin="0,6,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Source" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                                <ComboBox x:Name="SourceLangCombo" Width="160" SelectionChanged="OnLanguageSelectionChanged">
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="日本語" Tag="ja" />
                                    <ComboBoxItem Content="中文(繁體)" Tag="zh-Hant" />
                                    <ComboBoxItem Content="中文(简体)" Tag="zh-Hans" />
                                    <ComboBoxItem Content="Русский" Tag="ru" />
                                    <ComboBoxItem Content="Custom..." Tag="custom" />
                                </ComboBox>
                                <TextBox x:Name="SourceLangCustom" Width="90" Margin="8,0,0,0" LostFocus="OnSettingLostFocus" Visibility="Collapsed" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Target" VerticalAlignment="Center" Margin="0,6,0,0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                                                                <ComboBox x:Name="TargetLangCombo" Width="160" SelectionChanged="OnLanguageSelectionChanged">
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="日本語" Tag="ja" />
                                    <ComboBoxItem Content="中文(繁體)" Tag="zh-Hant" />
                                    <ComboBoxItem Content="中文(简体)" Tag="zh-Hans" />
                                    <ComboBoxItem Content="Русский" Tag="ru" />
                                    <ComboBoxItem Content="Custom..." Tag="custom" />
                                </ComboBox>
                                <TextBox x:Name="TargetLangCustom" Width="90" Margin="8,0,0,0" LostFocus="OnSettingLostFocus" Visibility="Collapsed" />
                                
                                <Button Grid.Row="1" Grid.Column="2" x:Name="SwapLangButton" Width="28" Height="28" Margin="6,6,0,0" HorizontalAlignment="Left" Click="OnSwapLanguages" ToolTip="Swap languages">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE117;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>


                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox x:Name="EnableDeepLCheck" Content="Enable DeepL" Click="OnSettingChanged" />
                                <CheckBox x:Name="EnableGeminiCheck" Content="Enable Gemini" Margin="12,0,0,0" Click="OnSettingChanged" />
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,10,0,10" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#33000000" BorderThickness="0,0,1,0" Padding="0,0,8,0">
                            <ListBox x:Name="SettingsCategoryList" SelectionChanged="OnSettingsCategoryChanged" SelectedIndex="0">
                                <ListBoxItem Content="OCR" />
                                <ListBoxItem Content="Paddle OCR" />
                                <ListBoxItem Content="Translation" />
                            </ListBox>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <StackPanel x:Name="SettingsPanelOcr">
                                <TextBlock Text="OCR (Advanced)" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="pHash threshold" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="PhashThresholdBox" Width="80" LostFocus="OnSettingLostFocus" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="IoU threshold" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="IouThresholdBox" Width="80" LostFocus="OnSettingLostFocus" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="SettingsPanelPaddle" Visibility="Collapsed" Margin="0,12,0,0">
                                <TextBlock Text="Paddle OCR" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Project" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="PaddleProjectDirBox" Width="180" LostFocus="OnSettingLostFocus" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Language" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="PaddleLanguageBox" Width="80" LostFocus="OnSettingLostFocus" />
                                    <TextBlock Text="Device" Width="50" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="PaddleDeviceBox" Width="60" LostFocus="OnSettingLostFocus" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="uv path" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="PaddleUvPathBox" Width="180" LostFocus="OnSettingLostFocus" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Model dir" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="PaddleModelDirBox" Width="180" LostFocus="OnSettingLostFocus" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="SettingsPanelTranslation" Visibility="Collapsed" Margin="0,12,0,0">
                                <TextBlock Text="Translation (Advanced)" FontWeight="SemiBold" />
                                <TextBlock x:Name="TranslationStatusText" Text="Translation status: unknown" Foreground="DimGray" Margin="0,6,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="DeepL API key" Width="120" VerticalAlignment="Center" />
                                    <PasswordBox x:Name="DeepLApiKeyBox" Width="200" LostFocus="OnSettingLostFocus" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="DeepL endpoint" Width="120" VerticalAlignment="Center" />
                                    <TextBox x:Name="DeepLEndpointBox" Width="200" LostFocus="OnSettingLostFocus" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Gemini API key" Width="120" VerticalAlignment="Center" />
                                    <PasswordBox x:Name="ApiKeyBox" Width="200" LostFocus="OnSettingLostFocus" />
                                </StackPanel>
                                <TextBlock Text="Translation priority" Margin="0,10,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <ListBox x:Name="TranslationPriorityList" Width="180" Height="80" />
                                    <StackPanel Margin="6,0,0,0">
                                        <Button Content="Up" Width="60" Click="OnTranslationPriorityUp" />
                                        <Button Content="Down" Width="60" Margin="0,6,0,0" Click="OnTranslationPriorityDown" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

        <TextBox x:Name="LogBox" Grid.Column="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
    </Grid>
</Window>
