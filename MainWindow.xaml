<Window x:Class="Hotkey_Translator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotkey_Translator"
        mc:Ignorable="d"
        Title="Hotkey Translator" Height="640" Width="1080">
    <Window.Resources>
        <local:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
        <local:BooleanOrMultiConverter x:Key="BooleanOrMultiConverter" />
        <local:BooleanAndMultiConverter x:Key="BooleanAndMultiConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BooleanToGridLengthConverter x:Key="BottomDrawerRowHeightConverter"
                                            TrueLength="300"
                                            FalseLength="0" />
        <Style x:Key="HeaderlessTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootLayout" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="{Binding DataContext.IsBottomPanelOpen, ElementName=RootLayout, Converter={StaticResource BottomDrawerRowHeightConverter}}" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" MinWidth="140" />
            <ColumnDefinition Width="*" MinWidth="640" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" BorderBrush="#33000000" BorderThickness="0,0,1,0" Padding="0,0,8,0" Margin="0,0,8,0">
            <StackPanel>
                <TextBlock Text="Sidebar" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox x:Name="HomeSidebarList"
                         SelectedIndex="{Binding SelectedSidebarIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ListBoxItem Content="Home" />
                    <ListBoxItem Content="Trans" />
                    <ListBoxItem Content="OCR" />
                    <ListBoxItem Content="Hotkey" />
                    <ListBoxItem Content="System" />
                </ListBox>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource HeaderlessTabControlStyle}"
                    SelectedIndex="{Binding SelectedRootTabIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <TabItem Header="Home">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="Capture" FontWeight="SemiBold" />
                        <Grid Margin="0,6,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CaptureModeBox" Width="200" HorizontalAlignment="Left"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding Settings.CaptureModeTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="Screen" Tag="Screen" />
                                <ComboBoxItem Content="Active Window" Tag="ActiveWindow" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Provider" VerticalAlignment="Center" Margin="0,6,0,0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                                <ComboBox x:Name="CaptureProviderBox" Width="200" HorizontalAlignment="Left"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding Settings.CaptureProviderTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="WGC" Tag="Wgc" />
                                    <ComboBoxItem Content="DXGI" Tag="Dxgi" />
                                    <ComboBoxItem Content="GDI" Tag="Gdi" />
                                </ComboBox>
                                <CheckBox x:Name="CaptureProviderFixedCheck" Content="Fixed only" VerticalAlignment="Center" Margin="10,0,0,0"
                                          IsChecked="{Binding Settings.IsCaptureProviderFixed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="ROI" VerticalAlignment="Center" Margin="0,6,0,0" />

                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="SelectRoiButton" Content="Select ROI" Width="140" HorizontalAlignment="Left" Command="{Binding SelectRoiCommand}" />
    
                                <CheckBox x:Name="EnableRoiCheck" Content="Enable" VerticalAlignment="Center" Margin="10,0,0,0"
                                          IsChecked="{Binding Settings.EnableRoi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RuntimeStatus.RoiStatusMessage}" Margin="0,6,0,0" Grid.ColumnSpan="2" />
                        </Grid>

                        <Separator Margin="0,10,0,10" />

                        <TextBlock Text="OCR" FontWeight="SemiBold" />
                        <Grid Margin="0,6,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Engine" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="OcrEngineBox" Width="200" HorizontalAlignment="Left"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding Settings.OcrEngineTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="WinRT (Windows)" Tag="WinRt" />
                                <ComboBoxItem Content="PaddleOCR (uv)" Tag="Paddle" />
                                <ComboBoxItem Content="PaddleOCR-VL (gRPC)" Tag="PaddleVllm" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Text="Use Settings &gt; PaddleOCR-VL runtime controls to apply changes and release OCR host resources."
                                   Foreground="DimGray"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <Separator Margin="0,10,0,10" />
                        <TextBlock Text="Translation" FontWeight="SemiBold" />

                        <Grid Margin="0,6,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Source" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Target" VerticalAlignment="Center" Margin="0,6,0,0" />

                            <!-- 右側（Source/Target + Swap）をひとつのGridにまとめる -->
                            <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />  <!-- Combo -->
                                    <ColumnDefinition Width="32" />   <!-- Swap -->
                                    <ColumnDefinition Width="Auto" /> <!-- Custom -->
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Source -->
                                <ComboBox Grid.Row="0" Grid.Column="0"
                                        x:Name="SourceLangCombo"
                                        Width="160"
                                        SelectedValuePath="Tag"
                                        SelectedValue="{Binding Settings.SourceLanguageTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="日本語" Tag="ja" />
                                    <ComboBoxItem Content="中文(繁體)" Tag="zh-Hant" />
                                    <ComboBoxItem Content="中文(简体)" Tag="zh-Hans" />
                                    <ComboBoxItem Content="Русский" Tag="ru" />
                                    <ComboBoxItem Content="Custom..." Tag="custom" />
                                </ComboBox>

                                <TextBox Grid.Row="0" Grid.Column="2"
                                        x:Name="SourceLangCustom"
                                        Width="90"
                                        Margin="8,0,0,0"
                                        Text="{Binding Settings.SourceLanguageCustom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.SourceLanguageTag}" Value="custom">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- Target -->
                                <ComboBox Grid.Row="1" Grid.Column="0"
                                        x:Name="TargetLangCombo"
                                        Width="160"
                                        Margin="0,6,0,0"
                                        SelectedValuePath="Tag"
                                        SelectedValue="{Binding Settings.TargetLanguageTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="日本語" Tag="ja" />
                                    <ComboBoxItem Content="中文(繁體)" Tag="zh-Hant" />
                                    <ComboBoxItem Content="中文(简体)" Tag="zh-Hans" />
                                    <ComboBoxItem Content="Русский" Tag="ru" />
                                    <ComboBoxItem Content="Custom..." Tag="custom" />
                                </ComboBox>

                                <TextBox Grid.Row="1" Grid.Column="2"
                                        x:Name="TargetLangCustom"
                                        Width="90"
                                        Margin="8,6,0,0"
                                        Text="{Binding Settings.TargetLanguageCustom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.TargetLanguageTag}" Value="custom">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- Swap（常にComboのすぐ右に固定） -->
                                <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                        x:Name="SwapLangButton"
                                        Width="28" Height="28"
                                        Margin="4,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Command="{Binding SwapLanguagesCommand}"
                                        ToolTip="Swap languages">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                                            Text="&#xE117;"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                </Button>
                            </Grid>

                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox x:Name="EnableDeepLCheck" Content="Enable DeepL"
                                          IsChecked="{Binding Settings.EnableDeepL, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="EnableGeminiCheck" Content="Enable Gemini" Margin="12,0,0,0"
                                          IsChecked="{Binding Settings.EnableGemini, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,10,0,10" />
                        <TextBlock Text="Overlay" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Overlay base font" Width="150" VerticalAlignment="Center" />
                            <Slider x:Name="OverlayFontSizeSlider"
                                    Width="180"
                                    Minimum="8"
                                    Maximum="96"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    SmallChange="1"
                                    LargeChange="2"
                                    Value="{Binding Settings.OverlayFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock x:Name="OverlayFontSizeValue"
                                       Width="48"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="{Binding ElementName=OverlayFontSizeSlider, Path=Value, StringFormat={}{0:F1}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Overlay opacity" Width="150" VerticalAlignment="Center" />
                            <Slider x:Name="OverlayBackgroundOpacitySlider"
                                    Width="180"
                                    Minimum="0"
                                    Maximum="1"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="0.05"
                                    SmallChange="0.01"
                                    LargeChange="0.1"
                                    Value="{Binding Settings.OverlayBackgroundOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock x:Name="OverlayBackgroundOpacityValue"
                                       Width="48"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="{Binding ElementName=OverlayBackgroundOpacitySlider, Path=Value, StringFormat={}{0:F2}}" />
                        </StackPanel>

                        <Separator Margin="0,10,0,10" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#33000000" BorderThickness="0,0,1,0" Padding="0,0,8,0" Visibility="Collapsed">
                                <ListBox x:Name="SettingsCategoryList"
                                         SelectedIndex="{Binding SelectedSettingsCategoryIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ListBoxItem Content="OCR" />
                                    <ListBoxItem Content="PaddleOCR-VL" />
                                    <ListBoxItem Content="Translation" />
                                    <ListBoxItem Content="Hotkeys" />
                                </ListBox>
                            </Border>

                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,0">
                            <StackPanel x:Name="SettingsPanelOcr"
                                        Visibility="{Binding SelectedSettingsCategoryIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">

                                <TextBlock Text="OCR (Advanced)" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="pHash threshold" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="PhashThresholdBox" Width="80"
                                             Text="{Binding Settings.PhashThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="IoU threshold" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="IouThresholdBox" Width="80"
                                             Text="{Binding Settings.IouThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Writing mode" Width="150" VerticalAlignment="Center" />
                                    <ComboBox x:Name="VerticalModeOverrideBox" Width="180"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding Settings.VerticalModeOverrideTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem Content="Auto" Tag="Auto" />
                                        <ComboBoxItem Content="Vertical (forced)" Tag="Vertical" />
                                        <ComboBoxItem Content="Horizontal (forced)" Tag="Horizontal" />
                                    </ComboBox>
                                </StackPanel>
                                <Separator Margin="0,10,0,8" />
                                <TextBlock Text="OCR Preprocess (Binarization)" FontWeight="SemiBold" />
                                <CheckBox x:Name="EnableOcrBinarizationCheck" Content="Enable binarization" Margin="0,6,0,0"
                                          IsChecked="{Binding Settings.EnableOcrBinarization, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="EnableOcrAutoThresholdCheck" Content="Auto threshold (Otsu)" Margin="0,4,0,0"
                                          IsEnabled="{Binding Settings.EnableOcrBinarization}"
                                          IsChecked="{Binding Settings.EnableOcrAutoThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="EnableOcrAutoInvertCheck" Content="Auto invert (dark background)" Margin="0,4,0,0"
                                          IsEnabled="{Binding Settings.EnableOcrBinarization}"
                                          IsChecked="{Binding Settings.EnableOcrAutoInvert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="EnableOcrGammaCheck" Content="Enable gamma correction" Margin="0,4,0,0"
                                          IsChecked="{Binding Settings.EnableOcrGamma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="EnableOcrTwoPassCheck" Content="Two-pass OCR (low/high)" Margin="0,6,0,0"
                                          IsEnabled="{Binding Settings.EnableOcrBinarization}"
                                          IsChecked="{Binding Settings.EnableOcrTwoPass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="OcrTwoPassPreferAutoCheck" Content="Prefer auto threshold when enabled" Margin="0,4,0,0"
                                          IsChecked="{Binding Settings.OcrTwoPassPreferAuto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <CheckBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource BooleanAndMultiConverter}">
                                            <Binding Path="Settings.EnableOcrBinarization" />
                                            <Binding Path="Settings.EnableOcrTwoPass" />
                                            <Binding Path="Settings.EnableOcrAutoThreshold" />
                                        </MultiBinding>
                                    </CheckBox.IsEnabled>
                                </CheckBox>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Low threshold" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="OcrTwoPassLowThresholdSlider"
                                            Width="180"
                                            Minimum="0"
                                            Maximum="255"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="5"
                                            SmallChange="1"
                                            LargeChange="10"
                                            Value="{Binding Settings.OcrTwoPassLowThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <Slider.IsEnabled>
                                            <MultiBinding Converter="{StaticResource BooleanAndMultiConverter}">
                                                <Binding Path="Settings.EnableOcrBinarization" />
                                                <Binding Path="Settings.EnableOcrTwoPass" />
                                            </MultiBinding>
                                        </Slider.IsEnabled>
                                    </Slider>
                                    <TextBlock x:Name="OcrTwoPassLowThresholdValue" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                               Text="{Binding ElementName=OcrTwoPassLowThresholdSlider, Path=Value, StringFormat={}{0:F0}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=OcrTwoPassLowThresholdSlider, Path=IsEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="DimGray" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="High threshold" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="OcrTwoPassHighThresholdSlider"
                                            Width="180"
                                            Minimum="0"
                                            Maximum="255"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="5"
                                            SmallChange="1"
                                            LargeChange="10"
                                            Value="{Binding Settings.OcrTwoPassHighThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <Slider.IsEnabled>
                                            <MultiBinding Converter="{StaticResource BooleanAndMultiConverter}">
                                                <Binding Path="Settings.EnableOcrBinarization" />
                                                <Binding Path="Settings.EnableOcrTwoPass" />
                                            </MultiBinding>
                                        </Slider.IsEnabled>
                                    </Slider>
                                    <TextBlock x:Name="OcrTwoPassHighThresholdValue" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                               Text="{Binding ElementName=OcrTwoPassHighThresholdSlider, Path=Value, StringFormat={}{0:F0}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=OcrTwoPassHighThresholdSlider, Path=IsEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="DimGray" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Threshold" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="OcrBinarizationThresholdSlider"
                                            Width="180"
                                            Minimum="0"
                                            Maximum="255"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="5"
                                            SmallChange="1"
                                            LargeChange="10"
                                            Value="{Binding Settings.OcrBinarizationThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <Slider.Style>
                                            <Style TargetType="Slider">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Settings.EnableOcrBinarization}" Value="True" />
                                                            <Condition Binding="{Binding Settings.EnableOcrAutoThreshold}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="IsEnabled" Value="True" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Slider.Style>
                                    </Slider>
                                    <TextBlock x:Name="OcrBinarizationThresholdValue" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                               Text="{Binding ElementName=OcrBinarizationThresholdSlider, Path=Value, StringFormat={}{0:F0}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=OcrBinarizationThresholdSlider, Path=IsEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="DimGray" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Gamma" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="OcrGammaSlider"
                                            Width="180"
                                            Minimum="0.6"
                                            Maximum="1.8"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="0.1"
                                            SmallChange="0.05"
                                            LargeChange="0.1"
                                            IsEnabled="{Binding Settings.EnableOcrGamma}"
                                            Value="{Binding Settings.OcrGamma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock x:Name="OcrGammaValue" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                               Text="{Binding ElementName=OcrGammaSlider, Path=Value, StringFormat={}{0:F2}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=OcrGammaSlider, Path=IsEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="DimGray" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Separator Margin="0,12,0,8" />
                                <TextBlock Text="Scene Change Automation" FontWeight="SemiBold" />
                                <CheckBox x:Name="EnableSceneChangeAutoHideCheck" Content="Enable auto-hide on scene change" Margin="0,6,0,0"
                                          IsChecked="{Binding Settings.EnableSceneChangeAutoHide, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="EnableSceneChangeAutoTranslateCheck" Content="Enable auto-translate on scene change" Margin="0,4,0,0"
                                          IsChecked="{Binding Settings.EnableSceneChangeAutoTranslate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Auto-translate keeps watching even when overlay is hidden." Foreground="DimGray" Margin="0,4,0,0" />
                                <CheckBox x:Name="EnableSceneChangeTextWeightedCheck" Content="Use text-weighted scoring" Margin="0,4,0,0"
                                          IsEnabled="{Binding Settings.EnableSceneChangeAutoHide}"
                                          IsChecked="{Binding Settings.EnableSceneChangeTextWeighted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Scene change threshold" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="SceneChangeThresholdSlider"
                                            Width="180"
                                            Minimum="0"
                                            Maximum="1"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="0.05"
                                            SmallChange="0.01"
                                            LargeChange="0.1"
                                            Value="{Binding Settings.SceneChangeThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <Slider.IsEnabled>
                                            <MultiBinding Converter="{StaticResource BooleanOrMultiConverter}">
                                                <Binding Path="Settings.EnableSceneChangeAutoHide" />
                                                <Binding Path="Settings.EnableSceneChangeAutoTranslate" />
                                            </MultiBinding>
                                        </Slider.IsEnabled>
                                    </Slider>
                                    <TextBlock x:Name="SceneChangeThresholdValue" Width="48" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                               Text="{Binding ElementName=SceneChangeThresholdSlider, Path=Value, StringFormat={}{0:F2}}">
