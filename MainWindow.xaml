                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Gemini API key" Width="120" VerticalAlignment="Center" />
                                    <PasswordBox x:Name="ApiKeyBox"
                                                 Width="200"
                                                 local:PasswordBoxAssistant.BoundPassword="{Binding Settings.ApiKeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="SettingsPanelHotkeys"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding SelectedSettingsCategoryIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=3}">
                                <TextBlock Text="Hotkeys" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Run once" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HotkeyRunOnceKeyBox" Width="80"
                                              SelectedItem="{Binding Settings.HotkeyRunOnceKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyRunOnceCtrl" Content="Ctrl" Margin="8,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyRunOnceCtrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyRunOnceAlt" Content="Alt" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyRunOnceAlt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyRunOnceShift" Content="Shift" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyRunOnceShift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Toggle overlay" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HotkeyToggleOverlayKeyBox" Width="80"
                                              SelectedItem="{Binding Settings.HotkeyToggleOverlayKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyToggleOverlayCtrl" Content="Ctrl" Margin="8,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyToggleOverlayCtrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyToggleOverlayAlt" Content="Alt" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyToggleOverlayAlt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyToggleOverlayShift" Content="Shift" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyToggleOverlayShift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Force run" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HotkeyForceRunKeyBox" Width="80"
                                              SelectedItem="{Binding Settings.HotkeyForceRunKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyForceRunCtrl" Content="Ctrl" Margin="8,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyForceRunCtrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyForceRunAlt" Content="Alt" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyForceRunAlt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyForceRunShift" Content="Shift" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyForceRunShift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Force Gemini (strict)" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HotkeyForceGeminiStrictKeyBox" Width="80"
                                              SelectedItem="{Binding Settings.HotkeyForceGeminiStrictKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyForceGeminiStrictCtrl" Content="Ctrl" Margin="8,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyForceGeminiStrictCtrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyForceGeminiStrictAlt" Content="Alt" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyForceGeminiStrictAlt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyForceGeminiStrictShift" Content="Shift" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyForceGeminiStrictShift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Overlay text" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HotkeyOcrOnlyKeyBox" Width="80"
                                              SelectedItem="{Binding Settings.HotkeyOcrOnlyKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyOcrOnlyCtrl" Content="Ctrl" Margin="8,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyOcrOnlyCtrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyOcrOnlyAlt" Content="Alt" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyOcrOnlyAlt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyOcrOnlyShift" Content="Shift" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyOcrOnlyShift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Scene auto-translate" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HotkeyToggleSceneAutoTranslateKeyBox" Width="80"
                                              SelectedItem="{Binding Settings.HotkeyToggleSceneAutoTranslateKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyToggleSceneAutoTranslateCtrl" Content="Ctrl" Margin="8,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyToggleSceneAutoTranslateCtrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyToggleSceneAutoTranslateAlt" Content="Alt" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyToggleSceneAutoTranslateAlt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyToggleSceneAutoTranslateShift" Content="Shift" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyToggleSceneAutoTranslateShift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Select ROI" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HotkeySelectRoiKeyBox" Width="80"
                                              SelectedItem="{Binding Settings.HotkeySelectRoiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeySelectRoiCtrl" Content="Ctrl" Margin="8,0,0,0"
                                              IsChecked="{Binding Settings.HotkeySelectRoiCtrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeySelectRoiAlt" Content="Alt" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeySelectRoiAlt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeySelectRoiShift" Content="Shift" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeySelectRoiShift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Lock window" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HotkeyLockCaptureWindowKeyBox" Width="80"
                                              SelectedItem="{Binding Settings.HotkeyLockCaptureWindowKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyLockCaptureWindowCtrl" Content="Ctrl" Margin="8,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyLockCaptureWindowCtrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyLockCaptureWindowAlt" Content="Alt" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyLockCaptureWindowAlt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyLockCaptureWindowShift" Content="Shift" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyLockCaptureWindowShift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Unlock window" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HotkeyUnlockCaptureWindowKeyBox" Width="80"
                                              SelectedItem="{Binding Settings.HotkeyUnlockCaptureWindowKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyUnlockCaptureWindowCtrl" Content="Ctrl" Margin="8,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyUnlockCaptureWindowCtrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyUnlockCaptureWindowAlt" Content="Alt" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyUnlockCaptureWindowAlt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="HotkeyUnlockCaptureWindowShift" Content="Shift" Margin="6,0,0,0"
                                              IsChecked="{Binding Settings.HotkeyUnlockCaptureWindowShift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <TextBlock Text="Note: Win key is not supported." Foreground="DimGray" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border x:Name="BottomDrawerBorder"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,8,0,0"
                BorderBrush="#33000000"
                BorderThickness="1"
                Padding="8"
                Background="#06000000"
                MinHeight="140"
                Visibility="{Binding IsBottomPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding BottomPreviewPaneVisible, Converter={StaticResource BottomDrawerRowHeightConverter}, ConverterParameter=star}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding BottomLogPaneVisible, Converter={StaticResource BottomDrawerRowHeightConverter}, ConverterParameter=star}" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0"
                          Header="OCR Preview"
                          MinWidth="220"
                          Visibility="{Binding BottomPreviewPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="4"
                          Cursor="Hand"
                          MouseLeftButtonUp="OnOcrPreviewClicked">
                        <Image x:Name="OcrPreprocessPreviewImage" Stretch="Uniform" />
                        <TextBlock x:Name="OcrPreprocessPreviewHint"
                                   Text="Run OCR to update preview."
                                   Foreground="DimGray"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns">
                    <GridSplitter.Style>
                        <Style TargetType="GridSplitter">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource BooleanAndMultiConverter}">
                                            <Binding Path="BottomPreviewPaneVisible" />
                                            <Binding Path="BottomLogPaneVisible" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </GridSplitter.Style>
                </GridSplitter>

                <GroupBox Grid.Column="2"
                          Header="Log"
                          MinWidth="220"
                          Visibility="{Binding BottomLogPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBox x:Name="LogBox"
                             Margin="4"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </GroupBox>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="0,8,0,0"
                BorderBrush="#33000000"
                BorderThickness="1"
                Padding="8,4">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding RuntimeStatus.TranslationStatusMessage}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Preview" Command="{Binding TogglePreviewPaneCommand}" Padding="8,0" Margin="0,0,8,0" />
                    <Button Content="Log" Command="{Binding ToggleLogPaneCommand}" Padding="8,0" Margin="0,0,8,0" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding RuntimeStatus.RoiStatusMessage}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Background="Transparent" Panel.ZIndex="10"
              Visibility="{Binding RuntimeStatus.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#F8FFFFFF" Padding="24" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding RuntimeStatus.BusyMessage}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ProgressBar Width="220" Height="6" IsIndeterminate="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
