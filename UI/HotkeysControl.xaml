                                      IsChecked="{Binding Settings.HotkeyToggleMirrorFullscreenAlt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox x:Name="HotkeyToggleMirrorFullscreenShift" Content="Shift" Margin="6,0,0,0"
                                      IsChecked="{Binding Settings.HotkeyToggleMirrorFullscreenShift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="HotkeyToggleMirrorFullscreenConflictHint" Style="{StaticResource HotkeyConflictHintStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Text="{uiLoc:Loc Key=Hotkey_Note_WinKeyUnsupported}"
                   Style="{StaticResource HelpTextStyle}"
                   Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
