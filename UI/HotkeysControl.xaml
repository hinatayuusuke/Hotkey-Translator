<UserControl x:Class="Hotkey_Translator.UI.HotkeysControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uiLoc="clr-namespace:Hotkey_Translator.UI.Localization"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="HotkeyRowBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="HotkeyRowLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="HotkeyConflictHintStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource HelpTextStyle}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{uiLoc:Loc Key=Hotkey_Title}" Style="{StaticResource SectionTitleTextStyle}" />
        <CheckBox x:Name="EnableRawInputHotkeysCheck"
                  Content="{uiLoc:Loc Key=Hotkey_EnableRawInputExperimental}"
                  Margin="0,6,0,0"
                  IsChecked="{Binding Settings.EnableRawInputHotkeys, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{uiLoc:Loc Key=Hotkey_RawInputNote}"
                   Style="{StaticResource HelpTextStyle}"
                   Margin="0,2,0,0" />
        <TextBlock x:Name="HotkeyConflictSummaryText"
                   Style="{StaticResource HelpTextStyle}"
                   Visibility="Collapsed"
                   Margin="0,8,0,0" />

        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="210" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HotkeyRunOnceRowBorder" Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource HotkeyRowBorderStyle}">
