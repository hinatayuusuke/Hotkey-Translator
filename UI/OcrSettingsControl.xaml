<UserControl x:Class="Hotkey_Translator.UI.OcrSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Hotkey_Translator"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">
    <UserControl.Resources>
        <local:BooleanAndMultiConverter x:Key="BooleanAndMultiConverter" />
    </UserControl.Resources>
    <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">

                                <TextBlock Text="OCR Tuning" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="pHash threshold" Width="150" VerticalAlignment="Center" />
                                    <ui:NumberBox x:Name="PhashThresholdBox"
                                                  Width="100"
                                                  MaxDecimalPlaces="0"
                                                  SmallChange="1"
                                                  LargeChange="4"
                                                  SpinButtonPlacementMode="Compact"
                                                  Value="{Binding Settings.PhashThresholdValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="IoU threshold" Width="150" VerticalAlignment="Center" />
                                    <ui:NumberBox x:Name="IouThresholdBox"
                                                  Width="100"
                                                  MaxDecimalPlaces="2"
                                                  SmallChange="0.05"
                                                  LargeChange="0.1"
                                                  SpinButtonPlacementMode="Compact"
                                                  Value="{Binding Settings.IouThresholdValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Writing mode" Width="150" VerticalAlignment="Center" />
                                    <ComboBox x:Name="VerticalModeOverrideBox" Width="180"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding Settings.VerticalModeOverrideTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem Content="Auto" Tag="Auto" />
                                        <ComboBoxItem Content="Vertical (forced)" Tag="Vertical" />
                                        <ComboBoxItem Content="Horizontal (forced)" Tag="Horizontal" />
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="EnableSimpleMergeTuningCheck"
                                          Content="Use simple merge tuning"
                                          Margin="0,8,0,0"
                                          IsChecked="{Binding Settings.EnableSimpleMergeTuning, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Horizontal merge strength" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="HorizontalMergeStrengthSlider"
                                            Width="180"
                                            Minimum="0"
                                            Maximum="100"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="5"
                                            SmallChange="1"
                                            LargeChange="10"
                                            IsEnabled="{Binding Settings.EnableSimpleMergeTuning}"
                                            Value="{Binding Settings.HorizontalMergeStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Width="36"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               Text="{Binding ElementName=HorizontalMergeStrengthSlider, Path=Value, StringFormat={}{0:F0}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Vertical merge strength" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="VerticalMergeStrengthSlider"
                                            Width="180"
                                            Minimum="0"
                                            Maximum="100"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="5"
                                            SmallChange="1"
                                            LargeChange="10"
                                            IsEnabled="{Binding Settings.EnableSimpleMergeTuning}"
                                            Value="{Binding Settings.VerticalMergeStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Width="36"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               Text="{Binding ElementName=VerticalMergeStrengthSlider, Path=Value, StringFormat={}{0:F0}}" />
                                </StackPanel>
                                <TextBlock Text="NOTE: Strength controls are mapped to internal merge thresholds."
                                           Foreground="DimGray"
                                           Margin="0,4,0,0" />
                                <Separator Margin="0,10,0,8" />
                                <TextBlock Text="OCR Preprocess (Binarization)" FontWeight="SemiBold" />
                                <CheckBox x:Name="EnableOcrBinarizationCheck" Content="Enable binarization" Margin="0,6,0,0"
                                          IsChecked="{Binding Settings.EnableOcrBinarization, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="EnableOcrAutoThresholdCheck" Content="Auto threshold (Otsu)" Margin="0,4,0,0"
                                          IsEnabled="{Binding Settings.EnableOcrBinarization}"
                                          IsChecked="{Binding Settings.EnableOcrAutoThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="EnableOcrGammaCheck" Content="Enable gamma correction" Margin="0,4,0,0"
                                          IsChecked="{Binding Settings.EnableOcrGamma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="EnableOcrGrayscaleCheck" Content="Enable grayscale conversion" Margin="0,4,0,0"
                                          IsChecked="{Binding Settings.EnableOcrGrayscale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="EnableOcrContrastCheck" Content="Enable contrast adjustment" Margin="0,4,0,0"
                                          IsChecked="{Binding Settings.EnableOcrContrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="EnableOcrTwoPassCheck" Content="Two-pass OCR (low/high)" Margin="0,6,0,0"
                                          IsEnabled="{Binding Settings.EnableOcrBinarization}"
                                          IsChecked="{Binding Settings.EnableOcrTwoPass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="OcrTwoPassPreferAutoCheck" Content="Prefer auto threshold when enabled" Margin="0,4,0,0"
                                          IsChecked="{Binding Settings.OcrTwoPassPreferAuto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <CheckBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource BooleanAndMultiConverter}">
                                            <Binding Path="Settings.EnableOcrBinarization" />
                                            <Binding Path="Settings.EnableOcrTwoPass" />
                                            <Binding Path="Settings.EnableOcrAutoThreshold" />
                                        </MultiBinding>
                                    </CheckBox.IsEnabled>
                                </CheckBox>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Low threshold" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="OcrTwoPassLowThresholdSlider"
                                            Width="180"
                                            Minimum="0"
                                            Maximum="255"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="5"
                                            SmallChange="1"
                                            LargeChange="10"
                                            Value="{Binding Settings.OcrTwoPassLowThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <Slider.IsEnabled>
                                            <MultiBinding Converter="{StaticResource BooleanAndMultiConverter}">
                                                <Binding Path="Settings.EnableOcrBinarization" />
                                                <Binding Path="Settings.EnableOcrTwoPass" />
                                            </MultiBinding>
                                        </Slider.IsEnabled>
                                    </Slider>
                                    <TextBlock x:Name="OcrTwoPassLowThresholdValue" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                               Text="{Binding ElementName=OcrTwoPassLowThresholdSlider, Path=Value, StringFormat={}{0:F0}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=OcrTwoPassLowThresholdSlider, Path=IsEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="DimGray" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="High threshold" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="OcrTwoPassHighThresholdSlider"
                                            Width="180"
                                            Minimum="0"
                                            Maximum="255"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="5"
                                            SmallChange="1"
                                            LargeChange="10"
                                            Value="{Binding Settings.OcrTwoPassHighThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <Slider.IsEnabled>
                                            <MultiBinding Converter="{StaticResource BooleanAndMultiConverter}">
                                                <Binding Path="Settings.EnableOcrBinarization" />
                                                <Binding Path="Settings.EnableOcrTwoPass" />
                                            </MultiBinding>
                                        </Slider.IsEnabled>
                                    </Slider>
                                    <TextBlock x:Name="OcrTwoPassHighThresholdValue" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                               Text="{Binding ElementName=OcrTwoPassHighThresholdSlider, Path=Value, StringFormat={}{0:F0}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=OcrTwoPassHighThresholdSlider, Path=IsEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="DimGray" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Threshold" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="OcrBinarizationThresholdSlider"
                                            Width="180"
                                            Minimum="0"
                                            Maximum="255"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="5"
                                            SmallChange="1"
                                            LargeChange="10"
                                            Value="{Binding Settings.OcrBinarizationThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <Slider.Style>
                                            <Style TargetType="Slider">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Settings.EnableOcrBinarization}" Value="True" />
                                                            <Condition Binding="{Binding Settings.EnableOcrAutoThreshold}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="IsEnabled" Value="True" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Slider.Style>
                                    </Slider>
                                    <TextBlock x:Name="OcrBinarizationThresholdValue" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                               Text="{Binding ElementName=OcrBinarizationThresholdSlider, Path=Value, StringFormat={}{0:F0}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=OcrBinarizationThresholdSlider, Path=IsEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="DimGray" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Gamma" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="OcrGammaSlider"
                                            Width="180"
                                            Minimum="0.6"
                                            Maximum="1.8"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="0.1"
                                            SmallChange="0.05"
                                            LargeChange="0.1"
                                            IsEnabled="{Binding Settings.EnableOcrGamma}"
                                            Value="{Binding Settings.OcrGamma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock x:Name="OcrGammaValue" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                               Text="{Binding ElementName=OcrGammaSlider, Path=Value, StringFormat={}{0:F2}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=OcrGammaSlider, Path=IsEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="DimGray" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Contrast" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="OcrContrastSlider"
                                            Width="180"
                                            Minimum="0.5"
                                            Maximum="2.0"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="0.1"
                                            SmallChange="0.05"
                                            LargeChange="0.1"
                                            IsEnabled="{Binding Settings.EnableOcrContrast}"
                                            Value="{Binding Settings.OcrContrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock x:Name="OcrContrastValue" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                               Text="{Binding ElementName=OcrContrastSlider, Path=Value, StringFormat={}{0:F2}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=OcrContrastSlider, Path=IsEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="DimGray" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                <TextBlock Text="OCR Input" FontWeight="SemiBold" />
                                <CheckBox x:Name="EnableOcrDownsamplingCheck"
                                          Content="Downsample OCR input"
                                          Margin="0,6,0,0"
                                          IsChecked="{Binding Settings.EnableOcrDownsampling, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Downsample scale" Width="150" VerticalAlignment="Center" />
                                    <Slider x:Name="OcrDownsampleScaleSlider"
                                            Width="180"
                                            Minimum="0.3"
                                            Maximum="1.0"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="0.05"
                                            SmallChange="0.05"
                                            LargeChange="0.1"
                                            IsEnabled="{Binding Settings.EnableOcrDownsampling}"
                                            Value="{Binding Settings.OcrDownsampleScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock x:Name="OcrDownsampleScaleValue"
                                               Width="48"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               Text="{Binding ElementName=OcrDownsampleScaleSlider, Path=Value, StringFormat={}{0:F2}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=OcrDownsampleScaleSlider, Path=IsEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="DimGray" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="OCR input preview is available in the bottom drawer." Margin="0,10,0,4" Foreground="DimGray" />
                                    </StackPanel>
                                </Grid>
    </StackPanel>
</UserControl>
