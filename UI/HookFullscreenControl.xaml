<UserControl x:Class="Hotkey_Translator.UI.HookFullscreenControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uiLoc="clr-namespace:Hotkey_Translator.UI.Localization"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleTextStyle}" />
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="170" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,12,0,0">
        <TextBlock Text="{uiLoc:Loc Key=Hook_Title}" Style="{StaticResource SectionTitleStyle}" />

        <TextBlock Text="{uiLoc:Loc Key=Hook_Title_GraphicsHook}" Style="{StaticResource SectionTitleStyle}" />
        <CheckBox Content="{uiLoc:Loc Key=Hook_EnableGraphicsHookPipeline}"
                  Margin="0,0,0,8"
                  IsChecked="{Binding Settings.EnableGraphicsHookPipeline, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{uiLoc:Loc Key=Hook_Label_Api}" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox Grid.Column="1"
                      Width="240"
                      HorizontalAlignment="Left"
                      IsEnabled="{Binding Settings.EnableGraphicsHookPipeline}"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding Settings.GraphicsHookApiTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ComboBoxItem Content="DX11" Tag="Dx11" />
                <ComboBoxItem Content="{uiLoc:Loc Key=Hook_Api_Dx9CaptureOnlyPlanned}" Tag="Dx9" />
                <ComboBoxItem Content="Vulkan" Tag="Vulkan" />
            </ComboBox>
        </Grid>

        <CheckBox Content="{uiLoc:Loc Key=Hook_EnableOverlayRendering}"
                  Margin="0,0,0,6"
                  IsEnabled="{Binding Settings.EnableGraphicsHookPipeline}"
                  IsChecked="{Binding Settings.GraphicsHookOverlayEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CheckBox Content="{uiLoc:Loc Key=Hook_FallbackToLegacyCaptureOnError}"
                  Margin="0,0,0,6"
                  IsEnabled="{Binding Settings.EnableGraphicsHookPipeline}"
                  IsChecked="{Binding Settings.GraphicsHookFallbackOnError, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{uiLoc:Loc Key=Hook_Label_CaptureFpsLimit}" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Grid.Column="1"
                     Width="80"
                     HorizontalAlignment="Left"
                     IsEnabled="{Binding Settings.EnableGraphicsHookPipeline}"
                     Text="{Binding Settings.GraphicsHookCaptureFpsLimitText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
        </Grid>

        <Expander Header="{uiLoc:Loc Key=Hook_Diagnostics}"
                  Margin="0,6,0,12"
                  IsEnabled="{Binding Settings.EnableGraphicsHookPipeline}">
            <StackPanel Margin="0,8,0,0">
                <CheckBox Content="{uiLoc:Loc Key=Hook_EnablePerfDiagnosticLog}"
                          Margin="0,0,0,6"
                          IsChecked="{Binding Settings.EnableGraphicsHookPerfDiagLog, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="{uiLoc:Loc Key=Hook_EnableDiagnosticFileSink}"
                          IsChecked="{Binding Settings.EnableGraphicsHookDiagFileSink, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Expander>

        <TextBlock Text="{uiLoc:Loc Key=Hook_Title_Launcher}" Style="{StaticResource SectionTitleStyle}" />
        <CheckBox Content="{uiLoc:Loc Key=Hook_EnableLauncher}"
                  Margin="0,0,0,8"
                  IsEnabled="{Binding Settings.EnableGraphicsHookPipeline}"
                  IsChecked="{Binding Settings.EnableGraphicsHookLauncher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{uiLoc:Loc Key=Hook_Label_LauncherExe}" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Grid.Column="1"
                     Width="420"
                     HorizontalAlignment="Left"
                     IsEnabled="{Binding Settings.EnableGraphicsHookLauncher}"
                     Text="{Binding Settings.GraphicsHookLauncherExePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2"
                    Content="{uiLoc:Loc Key=Common_Browse}"
                    Width="80"
                    Margin="8,0,0,0"
                    IsEnabled="{Binding Settings.EnableGraphicsHookLauncher}"
                    Click="OnBrowseLauncherClicked" />
        </Grid>

        <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{uiLoc:Loc Key=Hook_Label_LauncherArgs}" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Grid.Column="1"
                     Width="420"
                     HorizontalAlignment="Left"
                     IsEnabled="{Binding Settings.EnableGraphicsHookLauncher}"
                     Text="{Binding Settings.GraphicsHookLauncherArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2"
                    Content="{uiLoc:Loc Key=Hook_Launch}"
                    Width="100"
                    Margin="8,0,0,0"
                    IsEnabled="{Binding Settings.EnableGraphicsHookLauncher}"
                    Click="OnLaunchClicked" />
        </Grid>

        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{uiLoc:Loc Key=Hook_Label_SteamLaunch}" Style="{StaticResource FieldLabelStyle}" />
            <Button Grid.Column="1"
                    Content="{uiLoc:Loc Key=Common_Copy}"
                    Width="80"
                    IsEnabled="{Binding Settings.EnableGraphicsHookPipeline}"
                    Click="OnCopySteamLaunchOptionsClicked" />
        </Grid>

        <TextBlock Text="{uiLoc:Loc Key=Hook_Title_MirrorFullscreen}" Style="{StaticResource SectionTitleStyle}" Margin="0,12,0,4" />
        <CheckBox Content="{uiLoc:Loc Key=Hook_EnableMirrorFullscreenMode}"
                  Margin="0,0,0,8"
                  IsChecked="{Binding Settings.EnableMirrorFullscreenMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{uiLoc:Loc Key=Hook_Label_MagpieProfileIndex}" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Grid.Column="1"
                     Width="80"
                     HorizontalAlignment="Left"
                     IsEnabled="{Binding Settings.EnableMirrorFullscreenMode}"
                     Text="{Binding Settings.MagpieProfileIndexText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
        </Grid>
    </StackPanel>
</UserControl>
