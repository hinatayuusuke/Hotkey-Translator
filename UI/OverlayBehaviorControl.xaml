<UserControl x:Class="Hotkey_Translator.UI.OverlayBehaviorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Hotkey_Translator"
             xmlns:uiLoc="clr-namespace:Hotkey_Translator.UI.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">
    <UserControl.Resources>
        <local:BooleanAndMultiConverter x:Key="BooleanAndMultiConverter" />
        <local:BooleanOrMultiConverter x:Key="BooleanOrMultiConverter" />
    </UserControl.Resources>
    <StackPanel Margin="0,12,0,0">
        <TextBlock Text="{uiLoc:Loc Key=AutoTranslate_Title}" Style="{StaticResource SectionTitleTextStyle}" />
        <CheckBox Content="{uiLoc:Loc Key=AutoTranslate_EnableAutoHideOnSceneChange}"
                  Margin="0,6,0,0"
                  IsChecked="{Binding Settings.EnableSceneChangeAutoHide, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CheckBox Content="{uiLoc:Loc Key=AutoTranslate_EnableAutoTranslateOnSceneChange}"
                  Margin="0,4,0,0"
                  IsChecked="{Binding Settings.EnableSceneChangeAutoTranslate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CheckBox Content="{uiLoc:Loc Key=AutoTranslate_ShowBadgeIcon}"
                  Margin="0,4,0,0"
                  IsEnabled="{Binding Settings.EnableSceneChangeAutoTranslate}"
                  IsChecked="{Binding Settings.ShowAutoTranslateBadgeIcon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CheckBox Content="{uiLoc:Loc Key=AutoTranslate_CopyOcrTranslationToClipboard}"
                  Margin="0,4,0,0"
                  IsChecked="{Binding Settings.AutoCopyOcrTranslationToClipboard, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CheckBox Content="{uiLoc:Loc Key=AutoTranslate_EnableQuietWindow}"
                  Margin="0,4,0,0"
                  IsEnabled="{Binding Settings.EnableSceneChangeAutoTranslate}"
                  IsChecked="{Binding Settings.EnableSceneChangeQuietWindow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="{uiLoc:Loc Key=AutoTranslate_Label_QuietWindowMs}" Width="170" VerticalAlignment="Center" />
            <ui:NumberBox x:Name="SceneChangeQuietWindowMsBox"
                          Width="100"
                          MaxDecimalPlaces="0"
                          SmallChange="100"
                          LargeChange="500"
                          SpinButtonPlacementMode="Compact"
                          Value="{Binding Settings.SceneChangeQuietWindowMsValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ui:NumberBox.IsEnabled>
                    <MultiBinding Converter="{StaticResource BooleanAndMultiConverter}">
                        <Binding Path="Settings.EnableSceneChangeAutoTranslate" />
                        <Binding Path="Settings.EnableSceneChangeQuietWindow" />
                    </MultiBinding>
                </ui:NumberBox.IsEnabled>
                <ui:NumberBox.Style>
                    <Style TargetType="{x:Type ui:NumberBox}"
                           BasedOn="{StaticResource {x:Type ui:NumberBox}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=SceneChangeQuietWindowMsBox, Path=IsEnabled}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:NumberBox.Style>
            </ui:NumberBox>
        </StackPanel>
        <CheckBox Content="{uiLoc:Loc Key=AutoTranslate_UseTextWeightedScoring}"
                  Margin="0,4,0,0"
                  IsEnabled="{Binding Settings.EnableSceneChangeAutoHide}"
                  IsChecked="{Binding Settings.EnableSceneChangeTextWeighted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="{uiLoc:Loc Key=AutoTranslate_Label_WatchIntervalMs}" Width="170" VerticalAlignment="Center" />
            <Slider x:Name="SceneChangeWatchIntervalSlider"
                    Width="{StaticResource SliderStandardWidth}"
                    Minimum="200"
                    Maximum="5000"
                    IsSnapToTickEnabled="True"
                    TickFrequency="200"
                    SmallChange="100"
                    LargeChange="500"
                    Value="{Binding Settings.SceneChangeWatchIntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <Slider.IsEnabled>
                    <MultiBinding Converter="{StaticResource BooleanOrMultiConverter}">
                        <Binding Path="Settings.EnableSceneChangeAutoHide" />
                        <Binding Path="Settings.EnableSceneChangeAutoTranslate" />
                    </MultiBinding>
                </Slider.IsEnabled>
            </Slider>
            <TextBlock
                       Text="{Binding ElementName=SceneChangeWatchIntervalSlider, Path=Value, StringFormat={}{0:F0}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock"
                           BasedOn="{StaticResource SliderValueWideIntTextStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=SceneChangeWatchIntervalSlider, Path=IsEnabled}" Value="False">
                                <Setter Property="Foreground" Value="DimGray" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="{uiLoc:Loc Key=AutoTranslate_Label_WatcherPhashThreshold}" Width="170" VerticalAlignment="Center" />
            <Slider x:Name="SceneChangeWatchPhashSlider"
                    Width="{StaticResource SliderStandardWidth}"
                    Minimum="0"
                    Maximum="64"
                    IsSnapToTickEnabled="True"
                    TickFrequency="2"
                    SmallChange="1"
                    LargeChange="5"
                    Value="{Binding Settings.SceneChangeWatchPhashThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <Slider.IsEnabled>
                    <MultiBinding Converter="{StaticResource BooleanOrMultiConverter}">
                        <Binding Path="Settings.EnableSceneChangeAutoHide" />
                        <Binding Path="Settings.EnableSceneChangeAutoTranslate" />
                    </MultiBinding>
                </Slider.IsEnabled>
            </Slider>
            <TextBlock
                       Text="{Binding ElementName=SceneChangeWatchPhashSlider, Path=Value, StringFormat={}{0:F0}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock"
                           BasedOn="{StaticResource SliderValueIntTextStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=SceneChangeWatchPhashSlider, Path=IsEnabled}" Value="False">
                                <Setter Property="Foreground" Value="DimGray" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </StackPanel>
</UserControl>
