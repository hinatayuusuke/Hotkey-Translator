<UserControl x:Class="Hotkey_Translator.UI.Common.LabeledFieldRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d">
    <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Width="{Binding LabelWidth, ElementName=Root}"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center"
                   Text="{Binding Label, ElementName=Root}" />

        <StackPanel Grid.Column="1">
            <ContentPresenter Content="{Binding FieldContent, ElementName=Root}" />
            <TextBlock Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding Description, ElementName=Root}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock"
                           BasedOn="{StaticResource HelpTextStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
