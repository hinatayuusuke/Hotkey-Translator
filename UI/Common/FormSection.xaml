<UserControl x:Class="Hotkey_Translator.UI.Common.FormSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="{Binding Header, ElementName=Root}"
                   FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding Description, ElementName=Root}">
            <TextBlock.Style>
                <Style TargetType="TextBlock"
                       BasedOn="{StaticResource HelpTextStyle}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ContentPresenter Margin="0,6,0,0"
                          Content="{Binding SectionContent, ElementName=Root}" />
    </StackPanel>
</UserControl>
