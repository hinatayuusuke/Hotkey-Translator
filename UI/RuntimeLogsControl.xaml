<UserControl x:Class="Hotkey_Translator.UI.RuntimeLogsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Hotkey_Translator"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BooleanAndMultiConverter x:Key="BooleanAndMultiConverter" />
        <local:BooleanToGridLengthConverter x:Key="BottomDrawerRowHeightConverter"
                                            TrueLength="300"
                                            FalseLength="0" />
    </UserControl.Resources>

    <Border x:Name="BottomDrawerBorder"
            Style="{StaticResource ShellSurfaceBorderStyle}"
            Padding="10"
            Background="{DynamicResource ShellDrawerBackgroundBrush}"
            MinHeight="140"
            Visibility="{Binding IsBottomPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding BottomPreviewPaneVisible, Converter={StaticResource BottomDrawerRowHeightConverter}, ConverterParameter=star}" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{Binding BottomLogPaneVisible, Converter={StaticResource BottomDrawerRowHeightConverter}, ConverterParameter=star}" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0"
                     MinWidth="220"
                     Padding="12"
                     Visibility="{Binding BottomPreviewPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Preview" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />
                        <TextBlock Text="OCR preprocessing and pinned capture output"
                                   Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <TabControl Grid.Row="1">
                    <TabItem Header="OCR">
                        <Grid Cursor="Hand"
                              MouseLeftButtonUp="OnOcrPreviewClicked">
                            <Image x:Name="OcrPreprocessPreviewImage" Stretch="Uniform" />
                            <TextBlock x:Name="OcrPreprocessPreviewHint"
                                       Text="Run OCR to update preview."
                                       Foreground="DimGray"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="Pinned">
                        <Grid Cursor="Hand"
                              MouseLeftButtonUp="OnPinnedPreviewClicked">
                            <Image x:Name="PinnedCaptureThumbnailImage" Stretch="Uniform" />
                            <TextBlock x:Name="PinnedCaptureThumbnailHint"
                                       Text="No fixed target"
                                       Foreground="DimGray"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </TabItem>
                </TabControl>
                </Grid>
            </ui:Card>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource BooleanAndMultiConverter}">
                                        <Binding Path="BottomPreviewPaneVisible" />
                                        <Binding Path="BottomLogPaneVisible" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <ui:Card Grid.Column="2"
                     MinWidth="280"
                     Padding="12"
                     Visibility="{Binding BottomLogPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Log" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />
                        <TextBlock Text="Runtime status and diagnostics"
                                   Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <TextBox x:Name="LogBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </ui:Card>
        </Grid>
    </Border>
</UserControl>
