<UserControl x:Class="Hotkey_Translator.UI.RuntimeLogsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Hotkey_Translator"
             xmlns:uiLoc="clr-namespace:Hotkey_Translator.UI.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BooleanToGridLengthConverter x:Key="BottomDrawerRowHeightConverter"
                                            TrueLength="300"
                                            FalseLength="0" />
    </UserControl.Resources>

    <Border x:Name="BottomDrawerBorder"
            Style="{StaticResource ShellSurfaceBorderStyle}"
            Padding="10"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            MinHeight="140"
            Visibility="{Binding IsBottomPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding BottomPreviewPaneVisible, Converter={StaticResource BottomDrawerRowHeightConverter}, ConverterParameter=2*}" />
                <ColumnDefinition Width="{Binding BottomLogPaneVisible, Converter={StaticResource BottomDrawerRowHeightConverter}, ConverterParameter=3*}" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0"
                     MinWidth="220"
                     Padding="12"
                     Visibility="{Binding BottomPreviewPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{uiLoc:Loc Key=RuntimeLogs_PreviewTitle}"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,8" />
                    <TabControl Grid.Row="1"
                                MinHeight="220">
                        <TabItem Header="{uiLoc:Loc Key=RuntimeLogs_Tab_Ocr}">
                            <Grid MinHeight="140"
                                  Cursor="Hand"
                                  MouseLeftButtonUp="OnOcrPreviewClicked">
                                <Image x:Name="OcrPreprocessPreviewImage"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,12,0,0" />
                                <TextBlock x:Name="OcrPreprocessPreviewHint"
                                           Text="{uiLoc:Loc Key=RuntimeLogs_Hint_RunOcrToUpdatePreview}"
                                           Style="{StaticResource HelpTextStyle}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="{uiLoc:Loc Key=Common_Pinned}">
                            <Grid MinHeight="140"
                                  Cursor="Hand"
                                  MouseLeftButtonUp="OnPinnedPreviewClicked">
                                <Image x:Name="PinnedCaptureThumbnailImage"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,12,0,0" />
                                <TextBlock x:Name="PinnedCaptureThumbnailHint"
                                           Text="{uiLoc:Loc Key=RuntimeLogs_Hint_NoFixedTarget}"
                                           Style="{StaticResource HelpTextStyle}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Column="1"
                     MinWidth="280"
                     Padding="12"
                     Visibility="{Binding BottomLogPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{uiLoc:Loc Key=RuntimeLogs_LogTitle}"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,8" />
                    <TextBox x:Name="LogBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </ui:Card>
        </Grid>
    </Border>
</UserControl>
