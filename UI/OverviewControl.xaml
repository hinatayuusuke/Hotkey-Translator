<UserControl x:Class="Hotkey_Translator.UI.OverviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uiLoc="clr-namespace:Hotkey_Translator.UI.Localization"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="OverviewSectionBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="OverviewBlockTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="OverviewMutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
        </Style>
        <!-- WHY: Bind to the TextBox itself so the hint updates while typing, before LostFocus saves the value. -->
        <Style x:Key="LanguageCodePlaceholderStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <!-- WHY: The native TextBox can stay white in dark mode; match its foreground so the hint stays readable. -->
            <Setter Property="Foreground" Value="{Binding Foreground}" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="9,1,1,1" />
            <Setter Property="Padding" Value="{Binding Padding}" />
            <Setter Property="FontFamily" Value="{Binding FontFamily}" />
            <Setter Property="FontSize" Value="{Binding FontSize}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Text}" Value="" />
                        <Condition Binding="{Binding Visibility}" Value="Visible" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverviewLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="OverviewValueStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="QuickControlNameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="QuickControlGestureStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="QuickControlCardBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="MinHeight" Value="92" />
        </Style>
    </UserControl.Resources>

    <!-- WHY: Bind to the scroll viewport so Overview expands with the window while column MinWidth guards against over-compression. -->
    <StackPanel Margin="0,6,0,0"
                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}, FallbackValue=780}"
                HorizontalAlignment="Stretch">
        <Border Style="{StaticResource OverviewSectionBorderStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{uiLoc:Loc Key=Overview_QuickControlsTitle}" Style="{StaticResource OverviewBlockTitleStyle}" Margin="0" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource QuickControlCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="{uiLoc:Loc Key=Overview_RunOcrTranslate}" Style="{StaticResource QuickControlNameStyle}" />
                            <TextBlock Text="{Binding RunOnceHotkeyGesture}" Style="{StaticResource QuickControlGestureStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource QuickControlCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="{uiLoc:Loc Key=Overview_ToggleOverlay}" Style="{StaticResource QuickControlNameStyle}" />
                            <TextBlock Text="{Binding ToggleOverlayHotkeyGesture}" Style="{StaticResource QuickControlGestureStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource QuickControlCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="{uiLoc:Loc Key=Overview_SelectRoi}" Style="{StaticResource QuickControlNameStyle}" />
                            <TextBlock Text="{Binding SelectRoiHotkeyGesture}" Style="{StaticResource QuickControlGestureStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource QuickControlCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="{uiLoc:Loc Key=Overview_LockOcrWindow}" Style="{StaticResource QuickControlNameStyle}" />
                            <TextBlock Text="{Binding LockWindowHotkeyGesture}" Style="{StaticResource QuickControlGestureStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </Border>

        <Border Style="{StaticResource OverviewSectionBorderStyle}">
            <StackPanel>
                <TextBlock Text="{uiLoc:Loc Key=Overview_CurrentSetupTitle}" Style="{StaticResource OverviewBlockTitleStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{uiLoc:Loc Key=Overview_Label_Capture}" Style="{StaticResource OverviewLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CaptureModeSummary}" Style="{StaticResource OverviewValueStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{uiLoc:Loc Key=Overview_Label_Provider}" Style="{StaticResource OverviewLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CaptureProviderSummary}" Style="{StaticResource OverviewValueStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{uiLoc:Loc Key=Overview_Label_OcrEngine}" Style="{StaticResource OverviewLabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OcrEngineSummary}" Style="{StaticResource OverviewValueStyle}" />
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{uiLoc:Loc Key=Overview_Label_Translation}" Style="{StaticResource OverviewLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TranslationRouteSummary}" Style="{StaticResource OverviewValueStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{uiLoc:Loc Key=Overview_Label_HookFullscreen}" Style="{StaticResource OverviewLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HookStatusSummary}" Style="{StaticResource OverviewValueStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{uiLoc:Loc Key=Overview_Label_RoiStatus}" Style="{StaticResource OverviewLabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RuntimeStatus.RoiStatusMessage}" Style="{StaticResource OverviewValueStyle}" />
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource OverviewSectionBorderStyle}">
            <StackPanel>
                <TextBlock Text="{uiLoc:Loc Key=Overview_LanguageActionsTitle}" Style="{StaticResource OverviewBlockTitleStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{uiLoc:Loc Key=Overview_Label_SourceLanguage}" Style="{StaticResource OverviewLabelStyle}" />
                        <Grid Margin="0,0,0,6" Panel.ZIndex="1" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding Settings.SourceLanguageTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="{uiLoc:Loc Key=Language_English}" Tag="en" />
                                <ComboBoxItem Content="{uiLoc:Loc Key=Language_Japanese}" Tag="ja" />
                                <ComboBoxItem Content="{uiLoc:Loc Key=Language_Korean}" Tag="ko" />
                                <ComboBoxItem Content="{uiLoc:Loc Key=Language_ChineseTraditional}" Tag="zh-Hant" />
                                <ComboBoxItem Content="{uiLoc:Loc Key=Language_ChineseSimplified}" Tag="zh-Hans" />
                                <ComboBoxItem Content="{uiLoc:Loc Key=Language_Russian}" Tag="ru" />
                                <ComboBoxItem Content="{uiLoc:Loc Key=Language_Custom}" Tag="custom" />
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Width="38"
                                    Height="34"
                                    Padding="0" Margin="6,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Command="{Binding SwapLanguagesCommand}"
                                    ToolTip="{uiLoc:Loc Key=Overview_SwapLanguagesToolTip}">
                                <Button.RenderTransform>
                                    <TranslateTransform Y="32" />
                                </Button.RenderTransform>
                                <Viewbox Width="18"
                                         Height="18"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M6 21V3"
                                              Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                        <Path Data="M2 7l4-4 4 4"
                                              Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                        <Path Data="M18 3v18"
                                              Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                        <Path Data="M14 17l4 4 4-4"
                                              Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <TextBox x:Name="SourceLanguageCustomInput" Grid.Column="2"
                                     Margin="8,0,0,0"
                                     Text="{Binding Settings.SourceLanguageCustom, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.SourceLanguageTag}" Value="custom">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock Grid.Column="2"
                                       DataContext="{Binding ElementName=SourceLanguageCustomInput}"
                                       Text="{uiLoc:Loc Key=Language_CodePlaceholder}"
                                       Style="{StaticResource LanguageCodePlaceholderStyle}" />
                        </Grid>

                        <TextBlock Text="{uiLoc:Loc Key=Overview_Label_TargetLanguage}" Style="{StaticResource OverviewLabelStyle}" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding Settings.TargetLanguageTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="{uiLoc:Loc Key=Language_English}" Tag="en" />
                                <ComboBoxItem Content="{uiLoc:Loc Key=Language_Japanese}" Tag="ja" />
                                <ComboBoxItem Content="{uiLoc:Loc Key=Language_Korean}" Tag="ko" />
                                <ComboBoxItem Content="{uiLoc:Loc Key=Language_ChineseTraditional}" Tag="zh-Hant" />
                                <ComboBoxItem Content="{uiLoc:Loc Key=Language_ChineseSimplified}" Tag="zh-Hans" />
                                <ComboBoxItem Content="{uiLoc:Loc Key=Language_Russian}" Tag="ru" />
                                <ComboBoxItem Content="{uiLoc:Loc Key=Language_Custom}" Tag="custom" />
                            </ComboBox>
                            <TextBox x:Name="TargetLanguageCustomInput" Grid.Column="2"
                                     Margin="8,0,0,0"
                                     Text="{Binding Settings.TargetLanguageCustom, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.TargetLanguageTag}" Value="custom">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock Grid.Column="2"
                                       DataContext="{Binding ElementName=TargetLanguageCustomInput}"
                                       Text="{uiLoc:Loc Key=Language_CodePlaceholder}"
                                       Style="{StaticResource LanguageCodePlaceholderStyle}" />
                        </Grid>

                        <TextBlock Text="{uiLoc:Loc Key=Overview_Label_OcrEngine}" Style="{StaticResource OverviewLabelStyle}" />
                        <ComboBox Width="320"
                                  Margin="0,0,0,6"
                                  HorizontalAlignment="Left"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding Settings.OcrEngineTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="WinRT (Windows)" Tag="WinRt" />
                            <ComboBoxItem Content="OneOCR (native helper)" Tag="OneOcr" />
                            <ComboBoxItem Content="PaddleOCR (uv)" Tag="Paddle" />
                            <ComboBoxItem Content="PaddleOCR-VL (gRPC)" Tag="PaddleVllm" />
                            <ComboBoxItem Content="NDLOCR-Lite (gRPC)" Tag="Ndl" />
                            <ComboBoxItem Content="VisionLLM (gRPC)" Tag="VisionLlm" />
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock x:Name="WinRtLanguagePackStatusText"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource OverviewMutedTextStyle}"
                                       Visibility="Collapsed" />
                            <Button x:Name="InstallWinRtLanguagePackButton"
                                    Content="{uiLoc:Loc Key=Common_Install}"
                                    Margin="10,0,0,0"
                                    Padding="10,2"
                                    Visibility="Collapsed"
                                    Click="OnInstallWinRtLanguagePackClicked" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{uiLoc:Loc Key=Overview_Label_TranslationEngines}" Style="{StaticResource OverviewLabelStyle}" />
                        <WrapPanel Margin="0,0,0,8">
                            <CheckBox Content="DeepL"
                                      Margin="0,0,12,6"
                                      MinWidth="0"
                                      IsChecked="{Binding Settings.EnableDeepL, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="GoogleWeb"
                                      Margin="0,0,12,6"
                                      MinWidth="0"
                                      IsChecked="{Binding Settings.EnableGoogleWeb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="Gemini"
                                      Margin="0,0,12,6"
                                      MinWidth="0"
                                      IsChecked="{Binding Settings.EnableGemini, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="LlamaCpp"
                                      Margin="0,0,12,6"
                                      MinWidth="0"  
                                      IsChecked="{Binding Settings.EnableLlamaCppTranslation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>

                        <TextBlock Text="{uiLoc:Loc Key=Overview_Label_Roi}" Style="{StaticResource OverviewLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox Width="120"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding RoiPresetSlotItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedIndex="{Binding SelectedRoiPresetSlotIndex, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="OnOverviewRoiPresetSlotSelectionChanged" />
                            <CheckBox Content="{uiLoc:Loc Key=Overview_EnableRoi}"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.EnableRoi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Text="{uiLoc:Loc Key=Overview_Actions}" Style="{StaticResource OverviewLabelStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Width="144"
                                    Margin="0,0,12,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding RunOnceCommand}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{uiLoc:Loc Key=Overview_RunTest}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Width="144"
                                    HorizontalAlignment="Left"
                                    Command="{Binding SelectRoiCommand}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C2;" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{uiLoc:Loc Key=Overview_SelectRoi}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource OverviewSectionBorderStyle}">
            <StackPanel>
                <TextBlock Text="{uiLoc:Loc Key=Overview_QuickDisplaySettingsTitle}" Style="{StaticResource OverviewBlockTitleStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{uiLoc:Loc Key=Overview_Label_OverlayFontSize}" Style="{StaticResource OverviewLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Slider Width="{StaticResource SliderStandardWidth}"
                                    Minimum="8"
                                    Maximum="96"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    SmallChange="1"
                                    LargeChange="2"
                                    Value="{Binding Settings.OverlayFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource SliderValueDecimalTextStyle}"
                                       Text="{Binding Settings.OverlayFontSize, StringFormat={}{0:F1}}" />
                        </StackPanel>
                        <TextBlock Text="{uiLoc:Loc Key=Overview_Label_OverlayOpacity}" Style="{StaticResource OverviewLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Slider Width="{StaticResource SliderStandardWidth}"
                                    Minimum="0"
                                    Maximum="1"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="0.05"
                                    SmallChange="0.01"
                                    LargeChange="0.1"
                                    Value="{Binding Settings.OverlayBackgroundOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource SliderValueDecimalTextStyle}"
                                       Text="{Binding Settings.OverlayBackgroundOpacity, StringFormat={}{0:F2}}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <CheckBox Content="{uiLoc:Loc Key=Overview_FixedOverlayMode}"
                                  IsChecked="{Binding Settings.EnableFixedRoiOverlay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="{uiLoc:Loc Key=Overview_FixedOverlayTarget}" Style="{StaticResource OverviewLabelStyle}" />
                            <ComboBox Width="180"
                                       Margin="0,0,0,6"
                                       HorizontalAlignment="Left"
                                       SelectedValuePath="Tag"
                                       SelectedValue="{Binding Settings.FixedOverlayPlacementModeTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="{uiLoc:Loc Key=Overview_FixedOverlayTarget_Roi}" Tag="ROI" />
                                <ComboBoxItem Content="{uiLoc:Loc Key=Overview_FixedOverlayTarget_UserFrame}" Tag="User frame" />
                            </ComboBox>
                            <Button Width="180"
                                    HorizontalAlignment="Left"
                                    Click="OnSelectFixedOverlayFrameClicked"
                                    IsEnabled="{Binding Settings.IsFixedOverlayCustomFrameSelected}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C2;" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{uiLoc:Loc Key=Overview_SelectUserFrame}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource HelpTextStyle}"
                                       Text="{Binding Settings.FixedOverlayFrameStatusText}" />
                            <TextBlock Margin="0,2,0,0"
                                       Style="{StaticResource HelpTextStyle}"
                                       Text="{uiLoc:Loc Key=Overview_FixedOverlayNote}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource OverviewSectionBorderStyle}">
            <StackPanel>
                <TextBlock Text="{uiLoc:Loc Key=Overview_HookFullscreenTitle}" Style="{StaticResource OverviewBlockTitleStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{uiLoc:Loc Key=Overview_Label_ModeSummary}" Style="{StaticResource OverviewLabelStyle}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding HookStatusSummary}" Style="{StaticResource OverviewValueStyle}" Margin="0" VerticalAlignment="Center" />
                        </Grid>
                        <CheckBox Content="{uiLoc:Loc Key=Overview_EnableGraphicsHookPipeline}"
                                  Margin="0,0,0,4"
                                  IsChecked="{Binding Settings.EnableGraphicsHookPipeline, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="{uiLoc:Loc Key=Overview_EnableHookOverlayRendering}"
                                  IsEnabled="{Binding Settings.EnableGraphicsHookPipeline}"
                                  IsChecked="{Binding Settings.GraphicsHookOverlayEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{uiLoc:Loc Key=Overview_Label_MirrorMode}" Style="{StaticResource OverviewLabelStyle}" />
                        <CheckBox Content="{uiLoc:Loc Key=Overview_EnableMirrorFullscreenMode}"
                                  Margin="0,0,0,10"
                                  IsChecked="{Binding Settings.EnableMirrorFullscreenMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{uiLoc:Loc Key=Overview_HookApi}"
                                       Style="{StaticResource OverviewLabelStyle}"
                                       Margin="0" />
                            <ComboBox Grid.Column="2"
                                      Width="200"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding Settings.GraphicsHookApiTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="DX11" Tag="Dx11" />
                                <ComboBoxItem Content="DX9" Tag="Dx9" />
                                <ComboBoxItem Content="Vulkan" Tag="Vulkan" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
