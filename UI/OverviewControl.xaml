<UserControl x:Class="Hotkey_Translator.UI.OverviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="OverviewSectionBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="OverviewBlockTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="OverviewMutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
        </Style>
        <Style x:Key="OverviewLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="OverviewValueStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="QuickControlNameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="QuickControlGestureStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,6,0,0" Width="780" HorizontalAlignment="Left">
        <Border Style="{StaticResource OverviewSectionBorderStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Quick Controls" Style="{StaticResource OverviewBlockTitleStyle}" Margin="0" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Run OCR / Translate" Style="{StaticResource QuickControlNameStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding RunOnceHotkeyGesture}" Style="{StaticResource QuickControlGestureStyle}" />
                    </Grid>

                    <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Toggle overlay" Style="{StaticResource QuickControlNameStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding ToggleOverlayHotkeyGesture}" Style="{StaticResource QuickControlGestureStyle}" />
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Select ROI" Style="{StaticResource QuickControlNameStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectRoiHotkeyGesture}" Style="{StaticResource QuickControlGestureStyle}" />
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Lock OCR window" Style="{StaticResource QuickControlNameStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding LockWindowHotkeyGesture}" Style="{StaticResource QuickControlGestureStyle}" />
                    </Grid>
                </Grid>

            </StackPanel>
        </Border>

        <Border Style="{StaticResource OverviewSectionBorderStyle}">
            <StackPanel>
                <TextBlock Text="Current Setup" Style="{StaticResource OverviewBlockTitleStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Capture" Style="{StaticResource OverviewLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CaptureModeSummary}" Style="{StaticResource OverviewValueStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Provider" Style="{StaticResource OverviewLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CaptureProviderSummary}" Style="{StaticResource OverviewValueStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="OCR engine" Style="{StaticResource OverviewLabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OcrEngineSummary}" Style="{StaticResource OverviewValueStyle}" />
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Translation" Style="{StaticResource OverviewLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TranslationRouteSummary}" Style="{StaticResource OverviewValueStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Hook / Fullscreen" Style="{StaticResource OverviewLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HookStatusSummary}" Style="{StaticResource OverviewValueStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ROI status" Style="{StaticResource OverviewLabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RuntimeStatus.RoiStatusMessage}" Style="{StaticResource OverviewValueStyle}" />
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource OverviewSectionBorderStyle}">
            <StackPanel>
                <TextBlock Text="Language &amp; Actions" Style="{StaticResource OverviewBlockTitleStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Source language" Style="{StaticResource OverviewLabelStyle}" />
                        <Grid Margin="0,0,0,6" Panel.ZIndex="1" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding Settings.SourceLanguageTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="Japanese" Tag="ja" />
                                <ComboBoxItem Content="Traditional Chinese" Tag="zh-Hant" />
                                <ComboBoxItem Content="Simplified Chinese" Tag="zh-Hans" />
                                <ComboBoxItem Content="Russian" Tag="ru" />
                                <ComboBoxItem Content="Custom..." Tag="custom" />
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Width="38"
                                    Height="34"
                                    Padding="0" Margin="6,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Command="{Binding SwapLanguagesCommand}"
                                    ToolTip="Swap languages">
                                <Button.RenderTransform>
                                    <TranslateTransform Y="32" />
                                </Button.RenderTransform>
                                <Viewbox Width="18"
                                         Height="18"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M6 21V3"
                                              Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                        <Path Data="M2 7l4-4 4 4"
                                              Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                        <Path Data="M18 3v18"
                                              Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                        <Path Data="M14 17l4 4 4-4"
                                              Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <TextBox Grid.Column="2"
                                     Margin="8,0,0,0"
                                     Text="{Binding Settings.SourceLanguageCustom, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.SourceLanguageTag}" Value="custom">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>

                        <TextBlock Text="Target language" Style="{StaticResource OverviewLabelStyle}" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding Settings.TargetLanguageTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="Japanese" Tag="ja" />
                                <ComboBoxItem Content="Traditional Chinese" Tag="zh-Hant" />
                                <ComboBoxItem Content="Simplified Chinese" Tag="zh-Hans" />
                                <ComboBoxItem Content="Russian" Tag="ru" />
                                <ComboBoxItem Content="Custom..." Tag="custom" />
                            </ComboBox>
                            <TextBox Grid.Column="1"
                                     Margin="8,0,0,0"
                                     Text="{Binding Settings.TargetLanguageCustom, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.TargetLanguageTag}" Value="custom">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>

                        <TextBlock Text="OCR engine" Style="{StaticResource OverviewLabelStyle}" />
                        <ComboBox Width="280"
                                  Margin="0,0,0,6"
                                  HorizontalAlignment="Left"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding Settings.OcrEngineTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="WinRT (Windows)" Tag="WinRt" />
                            <ComboBoxItem Content="PaddleOCR (uv)" Tag="Paddle" />
                            <ComboBoxItem Content="PaddleOCR-VL (gRPC)" Tag="PaddleVllm" />
                            <ComboBoxItem Content="NDLOCR-Lite (gRPC)" Tag="Ndl" />
                            <ComboBoxItem Content="VisionLLM (gRPC)" Tag="VisionLlm" />
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock x:Name="WinRtLanguagePackStatusText"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource OverviewMutedTextStyle}"
                                       Visibility="Collapsed" />
                            <Button x:Name="InstallWinRtLanguagePackButton"
                                    Content="Install"
                                    Margin="10,0,0,0"
                                    Padding="10,2"
                                    Visibility="Collapsed"
                                    Click="OnInstallWinRtLanguagePackClicked" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Translation engines" Style="{StaticResource OverviewLabelStyle}" />
                        <UniformGrid Columns="3" Margin="0,0,0,6">
                            <CheckBox Content="DeepL"
                                      Margin="0,0,8,0"
                                      IsChecked="{Binding Settings.EnableDeepL, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="Gemini"
                                      Margin="0,0,8,0"
                                      IsChecked="{Binding Settings.EnableGemini, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="LlamaCpp"
                                      IsChecked="{Binding Settings.EnableLlamaCppTranslation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </UniformGrid>

                        <TextBlock Text="ROI" Style="{StaticResource OverviewLabelStyle}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      Width="120"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding RoiPresetSlotItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedIndex="{Binding SelectedRoiPresetSlotIndex, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="OnOverviewRoiPresetSlotSelectionChanged" />
                            <CheckBox Grid.Column="1"
                                      Content="Enable ROI"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.EnableRoi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <TextBlock Text="Actions" Style="{StaticResource OverviewLabelStyle}" />
                        <UniformGrid Columns="2">
                            <Button Width="132"
                                    Margin="0,0,8,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding RunOnceCommand}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Margin="0,0,6,0" />
                                    <TextBlock Text="Run test" />
                                </StackPanel>
                            </Button>
                            <Button Width="132"
                                    HorizontalAlignment="Left"
                                    Command="{Binding SelectRoiCommand}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C2;" Margin="0,0,6,0" />
                                    <TextBlock Text="Select ROI" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource OverviewSectionBorderStyle}">
            <StackPanel>
                <TextBlock Text="Quick Display Settings" Style="{StaticResource OverviewBlockTitleStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Overlay font size" Style="{StaticResource OverviewLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Slider Width="240"
                                    Minimum="8"
                                    Maximum="96"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    SmallChange="1"
                                    LargeChange="2"
                                    Value="{Binding Settings.OverlayFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Width="48"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="{Binding Settings.OverlayFontSize, StringFormat={}{0:F1}}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Overlay opacity" Style="{StaticResource OverviewLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Slider Width="180"
                                    Minimum="0"
                                    Maximum="1"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="0.05"
                                    SmallChange="0.01"
                                    LargeChange="0.1"
                                    Value="{Binding Settings.OverlayBackgroundOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Width="48"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="{Binding Settings.OverlayBackgroundOpacity, StringFormat={}{0:F2}}" />
                        </StackPanel>
                        <CheckBox Content="Fixed ROI overlay mode"
                                  IsChecked="{Binding Settings.EnableFixedRoiOverlay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource OverviewSectionBorderStyle}">
            <StackPanel>
                <TextBlock Text="Hook / Fullscreen" Style="{StaticResource OverviewBlockTitleStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mode summary" Style="{StaticResource OverviewLabelStyle}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding HookStatusSummary}" Style="{StaticResource OverviewValueStyle}" Margin="0" VerticalAlignment="Center" />
                        </Grid>
                        <CheckBox Content="Enable Graphics Hook pipeline"
                                  Margin="0,0,0,4"
                                  IsChecked="{Binding Settings.EnableGraphicsHookPipeline, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="Enable hook overlay rendering"
                                  IsEnabled="{Binding Settings.EnableGraphicsHookPipeline}"
                                  IsChecked="{Binding Settings.GraphicsHookOverlayEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Mirror mode" Style="{StaticResource OverviewLabelStyle}" />
                        <CheckBox Content="Enable mirror fullscreen mode"
                                  Margin="0,0,0,10"
                                  IsChecked="{Binding Settings.EnableMirrorFullscreenMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Hook API"
                                       Style="{StaticResource OverviewLabelStyle}"
                                       Margin="0" />
                            <ComboBox Grid.Column="2"
                                      Width="180"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding Settings.GraphicsHookApiTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="DX11" Tag="Dx11" />
                                <ComboBoxItem Content="DX9" Tag="Dx9" />
                                <ComboBoxItem Content="Vulkan" Tag="Vulkan" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
