<Window x:Class="Hotkey_Translator.UI.OcrPreviewZoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR Preview Zoom"
        Height="760"
        Width="1080"
        MinHeight="320"
        MinWidth="480">
    <Grid Background="#101010">
        <ScrollViewer x:Name="PreviewScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="OnPreviewMouseWheel">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="PreviewImage"
                       Stretch="None"
                       SnapsToDevicePixels="True">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="PreviewScaleTransform" ScaleX="1" ScaleY="1" />
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </ScrollViewer>

        <TextBlock x:Name="PreviewPlaceholder"
                   Text="No preview image yet."
                   Foreground="#D0D0D0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="16"
                   IsHitTestVisible="False" />

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="8"
                Padding="8,4"
                Background="#AA000000"
                CornerRadius="4">
            <TextBlock x:Name="ZoomText"
                       Foreground="White"
                       Text="100%" />
        </Border>
    </Grid>
</Window>
