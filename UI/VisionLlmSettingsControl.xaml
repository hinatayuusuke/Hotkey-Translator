<UserControl x:Class="Hotkey_Translator.UI.VisionLlmSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uiLoc="clr-namespace:Hotkey_Translator.UI.Localization"
             mc:Ignorable="d">
    <StackPanel>
                                  <TextBlock Text="{uiLoc:Loc Key=VisionLlm_Title}" Style="{StaticResource SectionTitleTextStyle}" />
                                  <TextBlock Text="{uiLoc:Loc Key=VisionLlm_AutoStartNote}"
                                             Style="{StaticResource HelpTextStyle}"
                                             Margin="0,4,0,0" />
                                  <TextBlock Text="{uiLoc:Loc Key=VisionLlm_ModelPathNote}"
                                             Style="{StaticResource HelpTextStyle}"
                                             Margin="0,6,0,0" />
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="{uiLoc:Loc Key=Translation_Label_Model}" Width="140" VerticalAlignment="Center" />
                                      <ComboBox x:Name="VisionLlmModelBox" Width="360"
                                                ItemsSource="{Binding VisionLlmModelOptions}"
                                                DisplayMemberPath="Display"
                                                SelectedValuePath="Value"
                                                SelectedValue="{Binding Settings.VisionLlmSelectedModelFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="{uiLoc:Loc Key=VisionLlm_Label_Mmproj}" Width="140" VerticalAlignment="Center" />
                                      <ComboBox x:Name="VisionLlmMmprojBox" Width="360"
                                                ItemsSource="{Binding VisionLlmMmprojOptions}"
                                                DisplayMemberPath="Display"
                                                SelectedValuePath="Value"
                                                SelectedValue="{Binding Settings.VisionLlmSelectedMmprojFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                      <Button Content="{uiLoc:Loc Key=Common_Reload}" Width="70" Margin="8,0,0,0" Command="{Binding ReloadVisionLlmModelsCommand}" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="{uiLoc:Loc Key=Translation_Label_RuntimeControl}" Width="140" VerticalAlignment="Center" />
                                      <Button Content="{uiLoc:Loc Key=Common_ApplyAndRestart}" Width="150" Command="{Binding RestartVisionLlmCommand}" />
                                      <Button Content="{uiLoc:Loc Key=Common_Stop}" Width="80" Margin="8,0,0,0" Command="{Binding StopVisionLlmCommand}" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="{uiLoc:Loc Key=Translation_Label_HttpHost}" Width="140" VerticalAlignment="Center" />
                                      <TextBox x:Name="VisionLlmHostBox" Width="120"
                                               Text="{Binding Settings.VisionLlmHostText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                      <TextBlock Text="{uiLoc:Loc Key=Common_Port}" Width="52" Margin="8,0,0,0" VerticalAlignment="Center" />
                                      <TextBox x:Name="VisionLlmPortBox" Width="80"
                                               Text="{Binding Settings.VisionLlmPortText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="{uiLoc:Loc Key=Translation_Label_ContextSize}" Width="140" VerticalAlignment="Center" />
                                      <TextBox x:Name="VisionLlmContextSizeBox" Width="80"
                                               Text="{Binding Settings.VisionLlmContextSizeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                      <TextBlock Text="{uiLoc:Loc Key=Translation_Label_GpuLayers}" Width="92" Margin="8,0,0,0" VerticalAlignment="Center" />
                                      <TextBox x:Name="VisionLlmGpuLayersBox" Width="80"
                                               Text="{Binding Settings.VisionLlmGpuLayersText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="{uiLoc:Loc Key=Translation_Label_Threads}" Width="140" VerticalAlignment="Center" />
                                      <TextBox x:Name="VisionLlmThreadsBox" Width="80"
                                               Text="{Binding Settings.VisionLlmThreadsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                      <TextBlock Text="{uiLoc:Loc Key=Translation_Label_Parallel}" Width="92" Margin="8,0,0,0" VerticalAlignment="Center" />
                                      <TextBox x:Name="VisionLlmParallelBox" Width="80"
                                               Text="{Binding Settings.VisionLlmParallelText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="{uiLoc:Loc Key=Translation_Label_BatchSize}" Width="140" VerticalAlignment="Center" />
                                      <TextBox x:Name="VisionLlmBatchSizeBox" Width="80"
                                               Text="{Binding Settings.VisionLlmBatchSizeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                      <TextBlock Text="{uiLoc:Loc Key=Translation_Label_MaxTokens}" Width="92" Margin="8,0,0,0" VerticalAlignment="Center" />
                                      <TextBox x:Name="VisionLlmMaxTokensBox" Width="80"
                                               Text="{Binding Settings.VisionLlmMaxTokensText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="{uiLoc:Loc Key=VisionLlm_Label_MaxImageSide}" Width="140" VerticalAlignment="Center" />
                                      <TextBox x:Name="VisionLlmMaxImageSideBox" Width="80"
                                               Text="{Binding Settings.VisionLlmMaxImageSideText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                  </StackPanel>
                                  <CheckBox x:Name="EnableVisionLlmSharedLocalTranslationCheck"
                                            Content="{uiLoc:Loc Key=VisionLlm_EnableSharedLocalTranslation}"
                                            Margin="0,8,0,0"
                                            IsChecked="{Binding Settings.EnableVisionLlmSharedLocalTranslation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                  <TextBlock Text="{uiLoc:Loc Key=VisionLlm_SharedLocalTranslationNote}"
                                             Style="{StaticResource HelpTextStyle}"
                                             Margin="0,4,0,0" />
                                  <CheckBox x:Name="EnableVisionGeometryHybridOcrCheck"
                                            Content="{uiLoc:Loc Key=VisionLlm_EnableGeometryAssistHybridOcr}"
                                            Margin="0,8,0,0"
                                            IsChecked="{Binding Settings.EnableVisionGeometryHybridOcr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                      <TextBlock Text="{uiLoc:Loc Key=VisionLlm_Label_HybridBaseOcr}" Width="140" VerticalAlignment="Center" />
                                      <ComboBox x:Name="VisionGeometryHybridBaseEngineBox"
                                                Width="160"
                                                SelectedValuePath="Tag"
                                                SelectedValue="{Binding Settings.VisionGeometryHybridBaseEngineTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding Settings.EnableVisionGeometryHybridOcr}">
                                          <ComboBoxItem Content="{uiLoc:Loc Key=OcrEngine_WinRt}" Tag="WinRt" />
                                          <ComboBoxItem Content="{uiLoc:Loc Key=OcrEngine_Ndl}" Tag="Ndl" />
                                          <ComboBoxItem Content="{uiLoc:Loc Key=OcrEngine_Paddle}" Tag="Paddle" />
                                          <ComboBoxItem Content="{uiLoc:Loc Key=OcrEngine_OneOcrNativeHelper}" Tag="OneOcr" />
                                      </ComboBox>
                                  </StackPanel>
                                  <TextBlock Text="{uiLoc:Loc Key=VisionLlm_GeometryAssistNote}"
                                             Style="{StaticResource HelpTextStyle}"
                                             Margin="0,4,0,0" />
    </StackPanel>
</UserControl>
